---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EmbedFrame from '../components/EmbedFrame.astro';
import { SITE } from '../data/site';

const formSrc =
  'https://docs.google.com/forms/d/e/1FAIpQLSekIgviVLcG3b7xQn3cu-639t-MEvX-Rhwdwp6xoGmbSSc24A/viewform?embedded=true';
const formView =
  'https://docs.google.com/forms/d/e/1FAIpQLSekIgviVLcG3b7xQn3cu-639t-MEvX-Rhwdwp6xoGmbSSc24A/viewform';
---

<BaseLayout title="Contact Us" description="Get in touch with The Crossing at CFCC Hayward.">
  <PageHeader
    title="Contact Us"
    eyebrow="Get in Touch"
    subtitle="Have questions about Sunday worship, small groups, or prayer requests? We'd love to hear from you."
    breadcrumbs={[{ label: 'Contact Us' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-10">
    <div class="grid divide-y divide-stone-300 border-y border-stone-300 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div class="py-7 sm:pr-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / Phone</p>
        <a href={SITE.phoneHref} class="mt-2 block font-display text-lg font-bold text-stone-900 hover:text-accent-hover">
          +1 {SITE.phone}
        </a>
      </div>
      <div class="py-7 sm:px-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / Email</p>
        <a href={`mailto:${SITE.email}`} class="mt-2 block font-display text-base font-bold text-stone-900 hover:text-accent-hover break-all">
          {SITE.email}
        </a>
      </div>
      <div class="py-7 sm:pl-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">03 / Address</p>
        <p class="mt-2 font-display text-base font-bold text-stone-900">{SITE.address.full}</p>
      </div>
    </div>

    <EmbedFrame
      src={formSrc}
      title="Contact The Crossing"
      heightClass="h-[720px]"
      openLabel="Open Google Form"
      openHref={formView}
    />
  </section>
</BaseLayout>
