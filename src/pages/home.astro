---
import { url } from '../lib/url';
const target = url('/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirecting to Home</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>Home</a>...</p>
  </body>
</html>
