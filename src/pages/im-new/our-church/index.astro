---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { url } from '../../../lib/url';

const values = [
  {
    title: "Experience God's Truth",
    desc: 'Rooted in Scripture as the supreme authority for faith and life.',
  },
  {
    title: 'Reach People',
    desc: 'Sharing the truth and grace of Jesus across the East Bay Area.',
  },
  {
    title: 'Authentic Community',
    desc: 'Building genuine, accountable relationships across life stages.',
  },
  {
    title: 'Maximize Involvement',
    desc: 'Equipping every member to serve with their God-given gifts.',
  },
  {
    title: 'Family Across Generations & Cultures',
    desc: 'Crossing generational and cultural lines together in Christ.',
  },
  {
    title: 'Worship God',
    desc: 'Honoring God in Sunday gathering and everyday mission.',
  },
];
---

<BaseLayout title="Our Church" description="Learn about The Crossing at Chinese For Christ Church of Hayward.">
  <PageHeader
    title="Our Church"
    eyebrow="Who We Are"
    subtitle="The English-speaking ministry of Chinese For Christ Church of Hayward serving the East Bay Area."
    backgroundImage="/images/site/community.webp"
    breadcrumbs={[{ label: "I'm New", href: '/im-new' }, { label: 'Our Church' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-6 space-y-4">
        <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Our Story</p>
        <h2 class="font-display text-2xl font-extrabold text-stone-900">About Us</h2>
        <p class="text-base leading-relaxed text-stone-700">
          The Crossing is the English-speaking ministry of Chinese For Christ Church of Hayward, a non-denominational, evangelical Christian church in the East Bay Area, CA.
        </p>
        <p class="text-base leading-relaxed text-stone-700">
          We are a church from singles to families, with a heart to be a multi-generational and multicultural community serving Hayward, Castro Valley, San Leandro, San Lorenzo, Union City, and beyond.
        </p>
      </div>
      <div class="md:col-span-6 overflow-clip rounded-xl aspect-[4/3]">
        <img
          src={url('/images/community/cross-gen-redwoods.webp')}
          alt="Cross-generational congregation of The Crossing together"
          loading="lazy"
          decoding="async"
          class="parallax-media h-full w-full object-cover object-[50%_45%]"
        />
      </div>
    </div>

    <div class="rounded-xl border border-stone-800 bg-obsidian p-8 sm:p-10 text-white space-y-4">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent">Our Vision</p>
      <blockquote class="font-serif italic text-2xl leading-snug sm:text-3xl">
        “THE CROSSING is an English-speaking, multiethnic ministry crossing generations and cultures together in Christ to love God, love people, and serve the world.”
      </blockquote>
      <p class="text-base leading-relaxed text-stone-300">
        This vision guides our spiritual community to worship, grow, and serve together, and reach people of the East Bay Area to also become followers of Jesus. Our goal is to experience a transformational, relational, missional life together in Christ, in our personal, local, and global contexts.
      </p>
    </div>

    <div>
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Core Commitments</p>
      <h2 class="mt-1 font-display text-2xl font-extrabold text-stone-900">Our Core Values</h2>
      <div class="mt-6 grid divide-y divide-stone-300 border-y border-stone-300 sm:grid-cols-2 lg:grid-cols-3 sm:divide-y-0">
        {values.map((v, idx) => (
          <div class="border-stone-300 py-6 sm:p-6 sm:border-b lg:[&:nth-child(n+4)]:border-b-0 sm:[&:nth-child(n+5)]:border-b-0">
            <p class="font-mono text-xs text-accent-hover">0{idx + 1}</p>
            <h3 class="mt-1 font-display text-base font-bold text-stone-900">{v.title}</h3>
            <p class="mt-2 text-sm text-stone-600">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-wrap gap-4 border-t border-stone-200 pt-8">
      <a
        href={url('/im-new/our-beliefs')}
        class="rounded-xl bg-obsidian px-5 py-3 text-sm font-bold text-white hover:bg-slate-dark transition-colors"
      >
        Read Our Beliefs
      </a>
      <a
        href={url('/im-new/our-staff')}
        class="rounded-xl border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-800 hover:bg-stone-100 transition-colors"
      >
        Meet Our Staff
      </a>
      <a
        href={url('/im-new/our-church/church-by-laws')}
        class="rounded-xl border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-800 hover:bg-stone-100 transition-colors"
      >
        Church By-Laws
      </a>
    </div>
  </section>
</BaseLayout>
