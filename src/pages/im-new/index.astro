---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import EmbedFrame from '../../components/EmbedFrame.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const faqs = [
  {
    q: 'Who are you?',
    a: 'The Crossing is the English-speaking, multiethnic ministry of Chinese For Christ Church of Hayward — a non-denominational, evangelical Christian church in the East Bay Area, CA.',
  },
  {
    q: 'When does church start?',
    a: "Our worship service starts at 9:30 AM every Sunday in the Worship Center's Main Sanctuary.",
  },
  {
    q: 'Where are you located?',
    a: 'Sunday worship is at CFCC Hayward, 157 Smalley Ave in Hayward, CA. There are signs and greeters to direct you to our service.',
  },
  {
    q: 'Where can I park?',
    a: 'We have spots reserved for first-time visitors in the main campus lots on Smalley Ave. For regular attendees, please park in Parking Lot C (the auxiliary lot) so spaces at the main campus remain available for visitors, elderly, and families. Due to limited parking, please carpool if possible.',
  },
  {
    q: 'What should I expect on Sunday?',
    a: 'A service that lasts about 75 minutes, live music and singing, friendly people who will make you feel welcomed, gospel-centered and biblically based messages, childcare and programs for kids, and a place to be yourself and meet new friends.',
  },
  {
    q: 'What should I wear?',
    a: 'Clothes! Dress as casually or formally as you feel comfortable. You are welcome here.',
  },
  {
    q: 'Is there something for my kids?',
    a: "Yes! We have The Rock children's program on Sundays starting at 9:30 AM (preschool through 5th grade), plus nursery care. Contact Min. Lisa Ko (lisa.ko@cfcchayward.org) for more information.",
  },
  {
    q: 'How do I get connected?',
    a: 'We have small groups throughout the week in different locations based on your life stage — including Growth Groups, Youth, Young Adults, Mature Adults, and Discipleship.',
  },
  {
    q: 'Am I expected to give anything?',
    a: "No! We pray that you will connect with God through worship and enjoy meeting people. As our guest, please don't feel any obligation to give.",
  },
  {
    q: 'Can I stream the service online?',
    a: "Yes! If you're unable to visit in person on Sunday, we livestream our worship service every week on The Crossing's YouTube Channel.",
  },
];
---

<BaseLayout title="I'm New" description="Plan your first visit to The Crossing at CFCC Hayward. Sundays at 9:30 AM.">
  <PageHeader
    title="Plan Your Visit"
    eyebrow="I'm New"
    subtitle="It can feel overwhelming to visit a church for the first time. Here is everything you need to know before Sunday."
    backgroundImage="/images/site/hero-sanctuary.webp"
    breadcrumbs={[{ label: "I'm New" }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <!-- FAQs -->
      <div class="min-w-0 lg:col-span-7 space-y-4">
        <h2 class="font-display text-2xl font-extrabold text-stone-900 sm:text-3xl">
          Frequently Asked Questions
        </h2>
        <div class="mt-6 space-y-3">
          {faqs.map((item, idx) => (
            <details
              open={idx < 2}
              class="group rounded-2xl border border-stone-200 bg-white p-5 shadow-xs transition-colors open:border-accent/50"
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-base font-bold text-stone-900 list-none">
                <span>{item.q}</span>
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-700 transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-stone-600">{item.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- Sidebar: Welcome Video & Quick Links -->
      <div class="min-w-0 lg:col-span-5 space-y-6">
        <YouTubeEmbed
          youtubeId="7fGWoEV_B9s"
          title="Welcome to The Crossing"
          speaker="CFCC Hayward"
        />

        <div class="rounded-2xl bg-obsidian p-6 text-white space-y-4">
          <p class="text-xs font-bold uppercase tracking-widest text-accent">Sunday Service</p>
          <h3 class="font-display text-xl font-bold">9:30 AM &bull; Main Sanctuary</h3>
          <p class="text-sm text-stone-300">{SITE.address.full}</p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href={url('/im-new/our-campus')}
              class="rounded-xl bg-accent px-4 py-2.5 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
            >
              Parking &amp; Campus Map
            </a>
            <a
              href={url('/get-connected')}
              class="rounded-xl border border-white/20 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
            >
              Get Connected
            </a>
          </div>
        </div>

        <EmbedFrame
          src={SITE.address.mapsEmbed}
          title="Directions to 157 Smalley Ave"
          heightClass="h-[280px]"
          openLabel="Open in Google Maps"
          openHref={SITE.address.mapsQuery}
        />
      </div>
    </div>
  </section>
</BaseLayout>
