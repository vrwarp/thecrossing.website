---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import EmbedFrame from '../../components/EmbedFrame.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const faqs = [
  {
    q: 'Who are you?',
    html: `The Crossing is the English-speaking, multiethnic ministry of <strong>Chinese For Christ Church of Hayward (CFCC)</strong> — a non-denominational, evangelical Christian church in the East Bay Area, CA. Learn more on our <a href="${url('/im-new/our-church')}" class="font-semibold text-accent-hover underline">Our Church</a> page.`,
  },
  {
    q: 'When does church start?',
    html: 'Our worship service starts at <strong>9:30 AM every Sunday</strong> in the Worship Center’s Main Sanctuary. After the service (~10:45 AM), stick around to meet people or join our <strong>11:15 AM Christian Education</strong> classes for adults, middle school, and high school.',
  },
  {
    q: 'Where are you located?',
    html: 'Sunday worship is at <strong>157 Smalley Ave in Hayward, CA</strong> (campus signage reads <em>Chinese For Christ Church of Hayward</em>). Greeters and signs will welcome you at the door.',
  },
  {
    q: 'Where can I park?',
    html: `We reserve spots specifically for <strong>first-time visitors</strong> in the main campus lots on Smalley Ave. Regular attendees park in Parking Lot C (the auxiliary lot). See our <a href="${url('/im-new/our-campus')}" class="font-semibold text-accent-hover underline">Campus &amp; Parking Map</a>.`,
  },
  {
    q: 'What should I expect on Sunday?',
    html: 'Expect a 75-minute service with live music and singing, friendly people who will make you feel welcomed, gospel-centered and biblically based messages, programs for kids, and a place to be yourself and meet new friends.',
  },
  {
    q: 'What should I wear?',
    html: 'Clothes! Dress as casually or formally as you feel comfortable. You are welcome here.',
  },
  {
    q: 'Is there something for my kids & teens?',
    html: `Yes! We have <a href="${url('/get-connected/children')}" class="font-semibold text-accent-hover underline">The Rock Children’s Ministry</a> (Nursery – 5th grade) on Sundays at 9:30 AM — no advance registration needed for your first visit; just arrive 10–15 minutes early at the 1st Floor Children’s Center. Middle &amp; High School students (Grades 6–12) join Sunday worship and meet for <a href="${url('/get-connected/youth')}" class="font-semibold text-accent-hover underline">Footprints Youth</a> on Fridays at 7:30 PM and Sunday CE at 11:15 AM.`,
  },
  {
    q: 'How do I get connected?',
    html: `We have weekly groups throughout the week based on your life stage — including Growth Groups, Youth, Young Adults, Mature Adults, and Discipleship. Explore them on <a href="${url('/get-connected')}" class="font-semibold text-accent-hover underline">Get Connected</a>.`,
  },
  {
    q: 'Am I expected to give anything?',
    html: 'No! We pray that you will connect with God through worship and enjoy meeting people. As our guest, please don’t feel any obligation to give.',
  },
  {
    q: 'Can I stream the service online?',
    html: `Yes! If you’re unable to visit in person on Sunday, we livestream our worship service every week on <a href="${SITE.social.youtubeStreams}" target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-hover underline">The Crossing’s YouTube Channel</a>.`,
  },
];
---

<BaseLayout title="I'm New" description="Plan your first visit to The Crossing at CFCC Hayward. Sundays at 9:30 AM.">
  <PageHeader
    title="Plan Your Visit"
    eyebrow="I'm New"
    subtitle="It can feel overwhelming to visit a church for the first time. Here is everything you need to know before Sunday."
    backgroundImage="/images/site/hero-sanctuary.webp"
    breadcrumbs={[{ label: "I'm New" }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <!-- FAQs -->
      <div class="min-w-0 lg:col-span-7">
        <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Sunday Guide</p>
        <h2 class="mt-2 font-display text-2xl font-extrabold text-stone-900 sm:text-3xl">
          Frequently Asked <span class="font-serif italic font-normal">Questions</span>
        </h2>
        <div class="mt-6 divide-y divide-stone-300 border-y border-stone-300">
          {faqs.map((item, idx) => (
            <details
              open={idx < 2}
              class="group py-5"
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-base font-bold text-stone-900 list-none">
                <span class="flex items-baseline gap-3">
                  <span class="font-mono text-xs font-medium text-stone-400">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <span>{item.q}</span>
                </span>
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-700 transition-transform group-open:rotate-45 group-open:border-stone-900">
                  +
                </span>
              </summary>
              <p class="mt-3 pl-7 text-sm leading-relaxed text-stone-600" set:html={item.html} />
            </details>
          ))}
        </div>
      </div>

      <!-- Sidebar: Welcome Video & Quick Links -->
      <div class="min-w-0 lg:col-span-5 space-y-6">
        <YouTubeEmbed
          youtubeId="7fGWoEV_B9s"
          title="Welcome to The Crossing"
          speaker="CFCC Hayward"
        />

        <div class="rounded-2xl bg-obsidian p-6 text-white space-y-4">
          <p class="text-xs font-bold uppercase tracking-widest text-accent">Sunday Service</p>
          <h3 class="font-display text-xl font-bold">9:30 AM &bull; Main Sanctuary</h3>
          <p class="text-sm text-stone-300">{SITE.address.full}</p>
          <p class="text-xs text-stone-400">
            Questions before Sunday? Call <a href={SITE.phoneHref} class="text-stone-200 underline">{SITE.phone}</a> or email{' '}
            <a href={`mailto:${SITE.email}`} class="text-stone-200 underline">{SITE.email}</a>.
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href={url('/contact-us')}
              class="rounded-xl bg-accent px-4 py-2.5 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
            >
              Let Us Know You're Coming
            </a>
            <a
              href={url('/im-new/our-campus')}
              class="rounded-xl border border-white/20 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
            >
              Parking &amp; Campus Map
            </a>
          </div>
        </div>

        <EmbedFrame
          src={SITE.address.mapsEmbed}
          title="Directions to 157 Smalley Ave"
          heightClass="h-[280px]"
          openLabel="Open in Google Maps"
          openHref={SITE.address.mapsQuery}
        />
      </div>
    </div>
  </section>
</BaseLayout>
