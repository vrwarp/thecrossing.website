---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../lib/url';

interface StaffMember {
  name: string;
  role: string;
  email?: string;
  image: string;
}

const pastoralStaff: StaffMember[] = [
  { name: 'Rev. Joshua Lee', role: 'Lead Pastor, The Crossing', email: 'josh.lee@cfcchayward.org', image: '/images/staff/joshua-lee.webp' },
  { name: 'Rev. Roy Yeh', role: 'Lead Pastor, Chinese Congregation', email: 'roy.yeh@cfcchayward.org', image: '/images/staff/roy-yeh.webp' },
  { name: 'Rev. Lili Zhang', role: 'Associate Chinese Pastor', email: 'lili.zhang@cfcchayward.org', image: '/images/staff/lili-zhang.webp' },
  { name: 'Rev. Daniel Tai', role: 'Associate Pastor, Youth & Young Adults', email: 'daniel.tai@cfcchayward.org', image: '/images/staff/daniel-tai.webp' },
  { name: 'Min. Lisa Ko', role: "Children's Minister", email: 'lisa.ko@cfcchayward.org', image: '/images/staff/lisa-ko.webp' },
];

const officeStaff: StaffMember[] = [
  { name: 'Tom Liu', role: 'Church Secretary', email: 'tom.liu@cfcchayward.org', image: '/images/staff/tom-liu.webp' },
  { name: 'Sherri Wong', role: 'The Crossing Administrative Assistant', email: 'staff.thecrossing@gmail.com', image: '/images/staff/sherri-wong.webp' },
];

const deacons: StaffMember[] = [
  { name: 'Alan Wan', role: 'Chairman of the Board & Property Deacon', image: '/images/staff/alan-wan.webp' },
  { name: 'Derrick Tao', role: 'Secretary of the Board & The Crossing Discipleship Deacon', image: '/images/staff/derrick-tao.webp' },
  { name: 'Pedro Mora', role: 'The Crossing Evangelism Deacon', image: '/images/staff/pedro-mora.webp' },
  { name: 'Kimberly Chang', role: 'Missions Deacon', image: '/images/staff/kimberly-chang.webp' },
  { name: 'Victor Huang', role: "Children's Ministry Deacon", image: '/images/staff/victor-huang.webp' },
  { name: 'Bonnie Wu', role: 'General Affairs Deacon', image: '/images/staff/bonnie-wu.webp' },
];

const sections = [
  { title: 'Pastoral Staff', members: pastoralStaff },
  { title: 'Church Office', members: officeStaff },
  { title: 'Deacons', members: deacons },
];
---

<BaseLayout title="Our Staff" description="Meet the pastors, office staff, and deacons serving The Crossing at CFCC Hayward.">
  <PageHeader
    title="Our Staff & Leadership"
    eyebrow="Leadership"
    subtitle="The Crossing is the English-speaking congregation of CFCC Hayward, serving alongside our Chinese Congregation. Meet the pastors, office staff, and deacons serving our church family."
    breadcrumbs={[{ label: "I'm New", href: '/im-new' }, { label: 'Our Staff' }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 space-y-16">
    <div class="border-l-2 border-accent pl-5 text-sm text-stone-700">
      <strong>Need to reach a Deacon or Ministry Lead?</strong> Contact the Church Office at{' '}
      <a href="mailto:church.office@cfcchayward.org" class="font-semibold text-accent-hover underline">church.office@cfcchayward.org</a>{' '}
      or <a href="tel:+15105811630" class="font-semibold text-accent-hover underline">510.581.1630</a>. For finance/giving inquiries, email{' '}
      <a href="mailto:financecfcch@gmail.com" class="font-semibold text-accent-hover underline">financecfcch@gmail.com</a>.
    </div>
    {sections.map((section) => (
      <div>
        <h2 class="font-display text-2xl font-extrabold text-stone-900 border-b border-stone-300 pb-3">
          {section.title}
        </h2>
        <div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {section.members.map((person) => (
            <figure>
              <div class="aspect-[4/5] w-full overflow-hidden rounded-xl bg-stone-200">
                <img
                  src={url(person.image)}
                  alt={person.name}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-top"
                />
              </div>
              <figcaption class="mt-3.5">
                <h3 class="font-display text-lg font-bold text-stone-900">{person.name}</h3>
                <p class="mt-0.5 text-sm text-stone-600">{person.role}</p>
                {person.email && (
                  <a
                    href={`mailto:${person.email}`}
                    class="mt-2 inline-block font-mono text-xs font-medium text-accent-hover hover:underline break-all"
                  >
                    {person.email}
                  </a>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
