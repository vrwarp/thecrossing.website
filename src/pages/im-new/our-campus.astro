---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmbedFrame from '../../components/EmbedFrame.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const rooms = [
  { name: 'Main Sanctuary', location: 'Worship Center (Main Floor)', use: 'Sunday 9:30 AM Worship Service' },
  { name: 'Children’s Center (The Rock)', location: '1st Floor', use: 'Sunday 9:30 AM Kids Check-In & Mon–Thu Homework Club' },
  { name: 'Room 107', location: 'Worship Center (1st Floor)', use: 'Transparent Young Adults (Thu) & Mature Adults (Fri)' },
  { name: 'Youth Center', location: '2nd Floor', use: 'Footprints Youth Group (Fridays 7:30 PM)' },
  { name: 'Room 201', location: '2nd Floor', use: 'Middle School Christian Education (Sundays 11:15 AM)' },
  { name: 'Room 202', location: '2nd Floor', use: 'Adult Christian Education (Sundays 11:15 AM)' },
  { name: 'Room 204', location: '2nd Floor', use: 'High School Christian Education (Sundays 11:15 AM)' },
];
---

<BaseLayout title="Our Campus" description="Campus map, parking lots, room directory, and directions to The Crossing at 157 Smalley Ave, Hayward, CA.">
  <PageHeader
    title="Our Campus & Parking"
    eyebrow="Directions"
    subtitle="157 Smalley Ave, Hayward, CA 94541 — campus signage reads Chinese For Christ Church of Hayward (CFCC)."
    breadcrumbs={[{ label: "I'm New", href: '/im-new' }, { label: 'Our Campus' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="grid divide-y divide-stone-300 border-y border-stone-300 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
      <div class="py-8 sm:pr-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / First-Time Visitors</p>
        <h2 class="font-display text-xl font-bold text-stone-900">Lot A (Visitor &amp; Handicap Parking)</h2>
        <p class="text-sm leading-relaxed text-stone-600">
          Lot A at 157 Smalley Ave has spots reserved for visitors and handicap parking (as well as elderly members). Signs and greeters will help direct you to the Main Sanctuary or the 1st Floor Children's Center.
        </p>
      </div>
      <div class="py-8 sm:pl-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / Regular Attendees</p>
        <h2 class="font-display text-xl font-bold text-stone-900">Parking Lot C (Auxiliary Lot)</h2>
        <p class="text-sm leading-relaxed text-stone-600">
          For regular attendees, please park in Parking Lot C (the auxiliary lot shown on the campus map below) so Lot A spaces remain open for visitors, elderly, and handicapped.
        </p>
      </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-stone-300">
      <img
        src={url('/images/site/campus-1.webp')}
        alt="CFCC Hayward Campus and Parking Map"
        loading="lazy"
        decoding="async"
        class="w-full h-auto"
      />
    </div>

    <div>
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Building Guide</p>
      <h2 class="mt-1 font-display text-2xl font-bold text-stone-900">Campus Room Directory</h2>
      <div class="mt-5 divide-y divide-stone-300 border-y border-stone-300">
        {rooms.map((r) => (
          <div class="grid gap-1 py-3.5 sm:grid-cols-3 sm:gap-4 text-sm">
            <div class="font-bold text-stone-900">{r.name}</div>
            <div class="text-stone-600">{r.location}</div>
            <div class="text-stone-600">{r.use}</div>
          </div>
        ))}
      </div>
    </div>

    <EmbedFrame
      src={SITE.address.mapsEmbed}
      title="Google Maps — 157 Smalley Ave, Hayward, CA"
      heightClass="h-[420px]"
      openLabel="Open in Google Maps"
      openHref={SITE.address.mapsQuery}
    />
  </section>
</BaseLayout>
