---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const teams = [
  {
    name: 'Hospitality & Greeters',
    cadence: 'Sundays • 9:00 AM',
    desc: 'Welcome first-time guests at the doors, help with visitor parking and seating, and foster a warm community after service.',
    contact: SITE.email,
  },
  {
    name: 'The Rock Children’s Ministry',
    cadence: 'Sundays 9:30 AM & Fridays',
    desc: 'Teach, assist, or care for nursery through 5th grade kids so families can worship knowing their children are loved and safe.',
    contact: 'lisa.ko@cfcchayward.org',
  },
  {
    name: 'Footprints Youth Leaders',
    cadence: 'Fridays 7:30 PM & Sundays 11:15 AM',
    desc: 'Mentor middle and high school students through small groups, games, and retreats.',
    contact: 'daniel.tai@cfcchayward.org',
  },
  {
    name: 'Worship & Tech / A/V',
    cadence: 'Sundays + Weekly Rehearsal',
    desc: 'Serve on the worship band, soundboard, slides, or YouTube livestream crew.',
    contact: SITE.email,
  },
  {
    name: 'Kids Homework Club',
    cadence: 'Mon–Thu • 3:30 – 5:30 PM',
    desc: 'Tutor and encourage K–7th grade students from our neighborhood with homework, crafts, and games.',
    contact: 'lisa.ko@cfcchayward.org',
  },
  {
    name: 'Bridging Grace Outreach',
    cadence: 'Monthly Deliveries',
    desc: 'Pack and deliver groceries and home essentials to East Bay families in need.',
    contact: 'bridginggrace@gmail.com',
  },
];
---

<BaseLayout title="Serve & Volunteer" description="Find a place to serve at The Crossing at CFCC Hayward.">
  <PageHeader
    title="Serve & Volunteer"
    eyebrow="Get Connected"
    subtitle="Maximize Involvement: God has uniquely gifted every believer to build up the church and serve our East Bay neighbors."
    breadcrumbs={[{ label: 'Get Connected', href: '/get-connected' }, { label: 'Serve & Volunteer' }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 space-y-14">
    <!-- Serving in Action Photo Strip -->
    <div class="grid gap-6 sm:grid-cols-3">
      <figure>
        <div class="aspect-[16/10] overflow-hidden rounded-xl">
          <img src={url('/images/community/moms-and-toddler.webp')} alt="Welcoming families at The Crossing" class="h-full w-full object-cover object-top" />
        </div>
        <figcaption class="mt-2.5 text-xs font-medium text-stone-600">Welcoming families &amp; first-time guests every Sunday.</figcaption>
      </figure>
      <figure>
        <div class="aspect-[16/10] overflow-hidden rounded-xl">
          <img src={url('/images/community/children-class.webp')} alt="Teaching kids in The Rock" class="h-full w-full object-cover object-top" />
        </div>
        <figcaption class="mt-2.5 text-xs font-medium text-stone-600">Investing in the next generation in The Rock Kids.</figcaption>
      </figure>
      <figure>
        <div class="aspect-[16/10] overflow-hidden rounded-xl">
          <img src={url('/images/community/youth-group-cross.webp')} alt="Footprints youth leaders and students" class="h-full w-full object-cover object-top" />
        </div>
        <figcaption class="mt-2.5 text-xs font-medium text-stone-600">Mentoring middle &amp; high school students in Footprints.</figcaption>
      </figure>
    </div>

    <div class="divide-y divide-stone-300 border-y border-stone-300">
      {teams.map((t) => (
        <article class="grid gap-3 py-6 sm:grid-cols-12 sm:items-baseline sm:gap-6">
          <p class="font-mono text-xs font-medium uppercase tracking-wider text-accent-hover sm:col-span-3">{t.cadence}</p>
          <div class="sm:col-span-6">
            <h2 class="font-display text-xl font-bold text-stone-900">{t.name}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-stone-600">{t.desc}</p>
          </div>
          <div class="sm:col-span-3 sm:text-right">
            <a
              href={`mailto:${t.contact}?subject=${encodeURIComponent(`Interested in serving: ${t.name}`)}`}
              class="inline-block font-mono text-xs font-semibold uppercase tracking-wider text-stone-900 hover:text-accent-hover"
            >
              Email Team Lead &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="rounded-2xl bg-obsidian p-8 text-white flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div>
        <h2 class="font-display text-2xl font-bold">Not sure where to start?</h2>
        <p class="mt-1 text-sm text-stone-300">Send us a quick note and a pastor or deacon will help you find a great fit.</p>
      </div>
      <a
        href={url('/contact-us')}
        class="shrink-0 rounded-xl bg-accent px-6 py-3 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
      >
        Contact Us
      </a>
    </div>
  </section>
</BaseLayout>
