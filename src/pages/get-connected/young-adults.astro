---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmbedFrame from '../../components/EmbedFrame.astro';
import { url } from '../../lib/url';

const calSrc =
  'https://calendar.google.com/calendar/embed?mode=agenda&showNav=0&showPrint=0&showTabs=0&showTitle=0&src=79bpk9dptkcanc5mgqo1peirik@group.calendar.google.com';
---

<BaseLayout title="Young Adults (Transparent)" description="Transparent Young Adults & College Fellowship at The Crossing.">
  <PageHeader
    title="Transparent Fellowship"
    eyebrow="Young Adults & College"
    subtitle="A community of young adult disciples transformed by God to live out a visible faith together."
    backgroundImage="/images/community/young-adults-park.webp"
    breadcrumbs={[{ label: 'Get Connected', href: '/get-connected' }, { label: 'Young Adults' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7 overflow-clip rounded-xl aspect-[16/10]">
        <img
          src={url('/images/community/young-adults-park.webp')}
          alt="Transparent Young Adults fellowship celebrating together in the park"
          class="parallax-media h-full w-full object-cover"
        />
      </div>
      <div class="md:col-span-5 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">Visible Faith Together</p>
        <h2 class="font-display text-2xl font-bold text-stone-900">Life &amp; Faith in Community</h2>
        <p class="text-sm leading-relaxed text-stone-600">
          Whether you're in college or navigating your career in the Bay Area, Transparent is a place to celebrate milestones, wrestle with Scripture, and serve together.
        </p>
      </div>
    </div>

    <div class="grid divide-y divide-stone-300 border-y border-stone-300 md:grid-cols-2 md:divide-x md:divide-y-0">
      <div class="py-8 md:pr-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / When &amp; Where</p>
        <h2 class="font-display text-xl font-bold text-stone-900">Thursdays at 7:45 PM</h2>
        <p class="text-sm text-stone-600">
          We meet at 7:45 PM on Thursdays in Room 107 of the Worship Center at CFCC Hayward to study, worship, and pray together. Please refer to the calendar below for exact dates.
        </p>
        <p class="text-xs text-stone-500 pt-1">
          Questions? Contact <a href="mailto:daniel.tai@cfcchayward.org" class="font-semibold text-accent-hover underline">Pastor Daniel Tai</a> or just drop by Room 107 on Thursday!
        </p>
      </div>

      <div class="py-8 md:pl-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / Our Goals</p>
        <ul class="space-y-1.5 text-sm text-stone-700 list-disc pl-4">
          <li>Connect young adults with Christ (personal spiritual growth)</li>
          <li>Connect young adults to His Family (spiritual community)</li>
          <li>Connect young adults with His Mission (serving outside the church)</li>
          <li>Grow intentionally in pursuit of living out a visible faith</li>
        </ul>
      </div>
    </div>

    <EmbedFrame
      src={calSrc}
      title="Transparent Young Adults Calendar"
      heightClass="h-[520px]"
    />
  </section>
</BaseLayout>
