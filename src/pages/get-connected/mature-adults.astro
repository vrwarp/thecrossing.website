---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../lib/url';

const values = [
  {
    name: 'Safety',
    desc: 'We pursue an environment and culture that is spiritually and emotionally safe for all group members.',
  },
  {
    name: 'Authenticity',
    desc: 'Growth takes place when followers of Christ are genuinely transparent with God and one another.',
  },
  {
    name: 'Humility',
    desc: 'Willingness to give and receive constructive feedback and support is essential to spiritual health.',
  },
  {
    name: 'Growth',
    desc: "God's desire and plan is that every believer continually grows in maturity in Christ.",
  },
];
---

<BaseLayout title="Mature Adults" description="Mature Adults Group at The Crossing — Fridays 7:30 PM.">
  <PageHeader
    title="Mature Adults Group"
    eyebrow="Get Connected"
    subtitle="Mutual support, encouragement, Bible study, and accountability for married or single adults and parents."
    backgroundImage="/images/community/mature-adults-group.webp"
    breadcrumbs={[{ label: 'Get Connected', href: '/get-connected' }, { label: 'Mature Adults' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7 overflow-hidden rounded-xl aspect-[16/10]">
        <img
          src={url('/images/community/mature-adults-group.webp')}
          alt="Mature Adults small group studying the Bible and sharing together in Room 107"
          class="h-full w-full object-cover object-center"
        />
      </div>
      <div class="md:col-span-5 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">Fridays • 7:30 – 9:30 PM</p>
        <h2 class="font-display text-2xl font-bold text-stone-900">Room 107, Worship Center</h2>
        <p class="text-sm leading-relaxed text-stone-600">
          Each Friday, we meet in discussion groups at church to study the Bible, then break into men's and women's groups for sharing and prayer. Newcomers are always welcome—or email{' '}
          <a href="mailto:church.office@cfcchayward.org?subject=Mature%20Adults%20Group" class="font-semibold text-accent-hover underline">church.office@cfcchayward.org</a>.
        </p>
      </div>
    </div>

    <div>
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Core Commitments</p>
      <h2 class="mt-1 font-display text-2xl font-extrabold text-stone-900">What We Value</h2>
      <div class="mt-6 grid divide-y divide-stone-300 border-y border-stone-300 sm:grid-cols-2 sm:divide-y-0">
        {values.map((v, idx) => (
          <div class="border-stone-300 py-6 sm:p-6 sm:odd:border-r sm:[&:nth-child(-n+2)]:border-b">
            <p class="font-mono text-xs text-stone-400">0{idx + 1}</p>
            <h3 class="mt-1 font-display text-lg font-bold text-stone-900">{v.name}</h3>
            <p class="mt-2 text-sm text-stone-600">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
