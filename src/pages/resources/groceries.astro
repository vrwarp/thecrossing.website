---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<BaseLayout title="Grocery Resources" description="Community grocery and food assistance resources in the East Bay.">
  <PageHeader
    title="Grocery Resources"
    eyebrow="Community Care"
    subtitle="Here are a few trusted resources to provide home essentials if your family is in need this season."
    breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Groceries' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid divide-y divide-stone-300 border-y border-stone-300 md:grid-cols-2 md:divide-x md:divide-y-0">
      <article class="flex flex-col justify-between py-8 md:py-10 md:pr-10 space-y-6">
        <div class="space-y-4">
          <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / East Bay Delivery</p>
          <h2 class="font-display text-2xl font-bold text-stone-900">Bridging Grace</h2>
          <p class="text-sm italic text-stone-600">"Bridging those in need with others who feel called to provide"</p>
          <p class="text-sm leading-relaxed text-stone-700">
            A Christian non-profit organization demonstrating the love of Jesus Christ by providing charitable supportive services to individuals and families in the local East Bay community. Volunteers deliver groceries and home essentials to families in need that reside in the East Bay (Hayward, San Lorenzo, San Leandro, and Castro Valley), especially those with young children and in low-income housing.
          </p>
        </div>
        <div class="space-y-2 border-t border-stone-200 pt-4 text-sm text-stone-700">
          <p>
            <strong>Website:</strong>{' '}
            <a href="https://www.bridginggrace.org/home" target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-hover underline">
              bridginggrace.org &nearr;
            </a>
          </p>
          <p>
            <strong>Email:</strong>{' '}
            <a href="mailto:bridginggrace@gmail.com" class="font-semibold text-accent-hover underline">
              bridginggrace@gmail.com
            </a>
          </p>
        </div>
      </article>

      <article class="flex flex-col justify-between py-8 md:py-10 md:pl-10 space-y-6">
        <div class="space-y-4">
          <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / County Partner</p>
          <h2 class="font-display text-2xl font-bold text-stone-900">Alameda County Community Food Bank</h2>
          <p class="text-sm leading-relaxed text-stone-700">
            Our church partners with Alameda County Community Food Bank every year during the holiday season because of their vision: for children, adults, and seniors of Alameda County not to worry about where their next meal is coming from.
          </p>
        </div>
        <div class="border-t border-stone-200 pt-4">
          <a
            href="https://www.accfb.org/get-food/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-xl bg-obsidian px-5 py-2.5 text-sm font-bold text-white hover:bg-slate-dark transition-colors"
          >
            Find Groceries or a Hot Meal &nearr;
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
