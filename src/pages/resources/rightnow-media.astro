---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<BaseLayout title="RightNow Media" description="Free access to RightNow Media video Bible studies through The Crossing.">
  <PageHeader
    title="RightNow Media"
    eyebrow="Video Library"
    subtitle='The "Netflix of video Bible studies" — over 20,000 videos, free through our church subscription.'
    breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'RightNow Media' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-10">
    <div class="rounded-2xl border border-stone-200 bg-white p-8 shadow-xs space-y-3">
      <h2 class="font-display text-2xl font-bold text-stone-900">How to Get Free Access</h2>
      <p class="text-sm leading-relaxed text-stone-700">
        RightNow Media has an extensive library of more than 20,000 Bible study videos from leaders like Francis Chan, Tim Keller, and many more. It is free for you — request an invite through Derrick Tao (Discipleship Deacon) by emailing{' '}
        <a href="mailto:church.office@cfcchayward.org?subject=RightNow%20Media%20Invite" class="font-semibold text-accent-hover underline">
          church.office@cfcchayward.org
        </a>.
      </p>
    </div>

    <div>
      <h2 class="font-display text-2xl font-extrabold text-stone-900">Recommended Series</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-2">
          <h3 class="font-display text-lg font-bold text-stone-900">You and Me Forever</h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-accent-hover">Francis &amp; Lisa Chan</p>
          <p class="text-sm text-stone-600">Seven-session Bible study on marriage, eternity, and pursuing God first.</p>
        </article>
        <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-2">
          <h3 class="font-display text-lg font-bold text-stone-900">Crazy Love</h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-accent-hover">Francis Chan</p>
          <p class="text-sm text-stone-600">Exploring the radical, unconditional, self-sacrificing love of God.</p>
        </article>
        <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-2">
          <h3 class="font-display text-lg font-bold text-stone-900">Culture Shock</h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-accent-hover">Chip Ingram</p>
          <p class="text-sm text-stone-600">Applying biblical truth with grace to pressing cultural questions.</p>
        </article>
        <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-2">
          <h3 class="font-display text-lg font-bold text-stone-900">The Reason for God</h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-accent-hover">Tim Keller</p>
          <p class="text-sm text-stone-600">Six-session unscripted conversations addressing tough questions about Christianity.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
