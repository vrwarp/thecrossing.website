---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmbedFrame from '../../components/EmbedFrame.astro';
import { url } from '../../lib/url';

const formSrc =
  'https://docs.google.com/forms/d/e/1FAIpQLSc9r3v6hyqnXEkOAx7TIFUiE6JbmVMm30M3t59qWtbi4dG82A/viewform?embedded=true';
const formView =
  'https://docs.google.com/forms/d/e/1FAIpQLSc9r3v6hyqnXEkOAx7TIFUiE6JbmVMm30M3t59qWtbi4dG82A/viewform';
---

<BaseLayout title="After-School Program" description="Free Kids Homework Club (K–7th Grade) at CFCC Hayward.">
  <PageHeader
    title="Kids Homework Club"
    eyebrow="After-School Program"
    subtitle="We provide a free after-school program for students in Kindergarten through 7th grade."
    backgroundImage="/images/community/children-class.webp"
    breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'After-School Program' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="grid divide-y divide-stone-300 border-y border-stone-300 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x">
      <div class="py-6 sm:p-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / Who</p>
        <p class="mt-1.5 font-display text-base font-bold text-stone-900">Kindergarten – 7th Grade</p>
      </div>
      <div class="py-6 sm:p-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / When</p>
        <p class="mt-1.5 font-display text-base font-bold text-stone-900">Mon–Thu • 3:30 – 5:30 PM</p>
      </div>
      <div class="py-6 sm:p-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">03 / Where</p>
        <p class="mt-1.5 font-display text-base font-bold text-stone-900">1st Floor Children's Center</p>
      </div>
      <div class="py-6 sm:p-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">04 / Cost</p>
        <p class="mt-1.5 font-display text-base font-bold text-stone-900">FREE!</p>
      </div>
    </div>

    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5 overflow-hidden rounded-xl aspect-[16/10]">
        <img
          src={url('/images/community/children-class.webp')}
          alt="Children and leaders in the 1st Floor Children's Center at The Crossing"
          class="parallax-media h-full w-full object-cover object-top"
        />
      </div>
      <div class="md:col-span-7 space-y-3 text-sm leading-relaxed text-stone-700">
        <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Daily Program</p>
        <p>
          Includes homework help, arts &amp; crafts, group games, fun activities, and snacks. We follow the local Hayward school-year calendar (no program on school holidays).
        </p>
        <p>
          <strong>Pick-Up &amp; Allergies:</strong> Parents/authorized guardians sign students out at the 1st Floor Children's Center by 5:30 PM. Please list any food allergies or pick-up permissions on the registration form below. Questions? Contact{' '}
          <a href="mailto:lisa.ko@cfcchayward.org" class="font-semibold text-accent-hover underline">
            Min. Lisa Ko (Children's Minister)
          </a>.
        </p>
      </div>
    </div>

    <EmbedFrame
      src={formSrc}
      title="Kids Homework Club Registration"
      heightClass="h-[740px]"
      openLabel="Open Registration Form"
      openHref={formView}
    />
  </section>
</BaseLayout>
