---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EmbedFrame from '../../../components/EmbedFrame.astro';

const scheduleEmbed =
  'https://docs.google.com/spreadsheets/d/1lsuomS3ifwFyo0NsKC6M33LbSWk8u-krvo3neEpscc8/htmlembed';
---

<BaseLayout title="Shepherding 101" description="Shepherding 101 Christian Education class at The Crossing.">
  <PageHeader
    title="Shepherding 101"
    eyebrow="Christian Education"
    subtitle="Equipping small group leaders and shepherds to care for God's people."
    breadcrumbs={[
      { label: 'Resources', href: '/resources' },
      { label: 'Christian Education', href: '/resources/ce' },
      { label: 'Shepherding 101' },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-8">
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs text-sm text-stone-700">
      <strong>Details:</strong> Room 202 &bull; Sundays, 11:15 AM – 12:15 PM.
    </div>
    <EmbedFrame src={scheduleEmbed} title="CE Schedule" heightClass="h-[460px]" />
  </section>
</BaseLayout>
