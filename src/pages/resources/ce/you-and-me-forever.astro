---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EmbedFrame from '../../../components/EmbedFrame.astro';

const scheduleEmbed =
  'https://docs.google.com/spreadsheets/d/1lsuomS3ifwFyo0NsKC6M33LbSWk8u-krvo3neEpscc8/htmlembed';

const themes = [
  "It's until death do us part. Then comes eternal rewards or regrets depending on how we spent our lives.",
  'While we cannot allow lesser things to destroy our marriages, we also cannot allow marriage to distract us from greater things.',
  'A jealous God asks us to pursue Him first and most. Then life makes sense, and everything falls into its proper place.',
  'Love, laughter, and intimacy were all created to be enjoyed. So there is a way to love family deeply without ignoring heaven.',
  'It all comes down to our focus.',
  'Jesus was right. We have it all backwards. The way to have a great marriage is by not focusing on marriage.',
];
---

<BaseLayout title="You and Me Forever" description="You and Me Forever Christian Education class at The Crossing.">
  <PageHeader
    title="You and Me Forever"
    eyebrow="Christian Education • May 11 – June 25, 2025"
    subtitle="Marriage is great, but it's not forever — pursuing Christ first in marriage and family."
    breadcrumbs={[
      { label: 'Resources', href: '/resources' },
      { label: 'Christian Education', href: '/resources/ce' },
      { label: 'You and Me Forever' },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-10">
    <div class="border-l-2 border-accent pl-6 space-y-4">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Series Overview</p>
      <h2 class="font-display text-2xl font-bold text-stone-900">Marriage is Great, But it's not Forever</h2>
      <p class="text-sm leading-relaxed text-stone-700">
        This seven-session Bible study series, based on the book <em>You and Me Forever</em> from best-selling authors Francis Chan and Lisa Chan, will challenge you to view your marriage like never before. These seven inspiring videos help you dive deeper into themes like:
      </p>
      <ul class="space-y-2 text-sm text-stone-700 list-disc pl-5">
        {themes.map((t) => <li>{t}</li>)}
      </ul>
      <div class="pt-3 flex flex-wrap items-center justify-between gap-4 border-t border-stone-300">
        <p class="text-sm text-stone-600"><strong>Details:</strong> Room 202 &bull; Sundays, 11:15 AM – 12:15 PM.</p>
        <a
          href="https://app.rightnowmedia.org/en/content/details/1213"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
        >
          Watch on RightNow Media! &nearr;
        </a>
      </div>
    </div>

    <EmbedFrame src={scheduleEmbed} title="The Crossing CE Schedule" heightClass="h-[440px]" />
  </section>
</BaseLayout>
