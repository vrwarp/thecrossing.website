---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EmbedFrame from '../../../components/EmbedFrame.astro';
import { url } from '../../../lib/url';

const scheduleEmbed =
  'https://docs.google.com/spreadsheets/d/1lsuomS3ifwFyo0NsKC6M33LbSWk8u-krvo3neEpscc8/htmlembed';
const scheduleOpen =
  'https://docs.google.com/spreadsheets/d/1lsuomS3ifwFyo0NsKC6M33LbSWk8u-krvo3neEpscc8/edit';

const previousClasses = [
  { title: 'Shepherding 101', href: '/resources/ce/shepherding-101', desc: 'Equipping small group leaders and shepherds.' },
  { title: 'Together CE', href: '/resources/ce/together-ce', desc: 'RightNow Media video series on community.' },
  { title: 'Why Believe? CE', href: '/resources/ce/why-believe', desc: 'Apologetics and exploring Christian faith.' },
  { title: 'You and Me Forever', href: '/resources/ce/you-and-me-forever', desc: 'Marriage and eternity by Francis & Lisa Chan.' },
];
---

<BaseLayout title="Christian Education" description="Sunday 11:15 AM Christian Education workshops and classes at The Crossing.">
  <PageHeader
    title="Christian Education"
    eyebrow="Resources • Sundays 11:15 AM"
    subtitle="Workshops and classes after Sunday service designed to equip you in Scripture, theology, and everyday Christian living."
    breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Christian Education' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs">
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">Where</p>
        <p class="mt-2 font-display text-lg font-bold text-stone-900">Room 202 (Adults)</p>
        <p class="mt-1 text-xs text-stone-500">Youth CE: Room 201 (MS) &amp; 204 (HS)</p>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs">
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">When</p>
        <p class="mt-2 font-display text-lg font-bold text-stone-900">Sundays, 11:15 AM – 12:15 PM</p>
        <p class="mt-1 text-xs text-stone-500">Check schedule below for active dates</p>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs">
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">Questions?</p>
        <p class="mt-2 font-display text-lg font-bold text-stone-900">Derrick Tao &amp; CE Core</p>
        <p class="mt-1 text-xs text-stone-500">Suggest future workshop topics anytime</p>
      </div>
    </div>

    <EmbedFrame
      src={scheduleEmbed}
      title="Christian Education Schedule"
      heightClass="h-[460px]"
      openLabel="Open Schedule Sheet"
      openHref={scheduleOpen}
    />

    <div>
      <h2 class="font-display text-2xl font-extrabold text-stone-900">Previous Classes</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        {previousClasses.map((c) => (
          <a
            href={url(c.href)}
            class="group rounded-2xl border border-stone-200 bg-white p-6 shadow-xs transition-all hover:border-accent/50 hover:shadow-md"
          >
            <h3 class="font-display text-lg font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
              {c.title} &rarr;
            </h3>
            <p class="mt-1.5 text-sm text-stone-600">{c.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
