---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EmbedFrame from '../../../components/EmbedFrame.astro';

const scheduleEmbed =
  'https://docs.google.com/spreadsheets/d/1tEaGu8185S1rsjtRSDKSi-2yQyggU95Ephzbgf2tUlY/htmlembed';
const formEmbed =
  'https://docs.google.com/forms/d/e/1FAIpQLSfWu51RaFr_1MJ0-LFQ3ghVaEvNjN2H-kySdqbq4NKjAfFQ7A/viewform?embedded=true';
---

<BaseLayout title="Why Believe? CE" description="Why Believe? Christian Education apologetics class at The Crossing.">
  <PageHeader
    title="Why Believe? CE"
    eyebrow="Christian Education"
    subtitle="Exploring honest questions about Christianity, Scripture, and faith."
    breadcrumbs={[
      { label: 'Resources', href: '/resources' },
      { label: 'Christian Education', href: '/resources/ce' },
      { label: 'Why Believe? CE' },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-10">
    <EmbedFrame src={scheduleEmbed} title="Why Believe? Schedule" heightClass="h-[440px]" />
    <EmbedFrame src={formEmbed} title="Why Believe? Sign-Up & Questions" heightClass="h-[640px]" />
  </section>
</BaseLayout>
