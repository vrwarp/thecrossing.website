---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
---

<BaseLayout title="Together CE" description="Together Christian Education class at The Crossing.">
  <PageHeader
    title="Together CE"
    eyebrow="Christian Education"
    subtitle="A RightNow Media video series exploring authentic Christian community and friendship."
    breadcrumbs={[
      { label: 'Resources', href: '/resources' },
      { label: 'Christian Education', href: '/resources/ce' },
      { label: 'Together CE' },
    ]}
  />

  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-stone-200 bg-white p-8 shadow-xs space-y-4">
      <h2 class="font-display text-2xl font-bold text-stone-900">Class Overview</h2>
      <p class="text-sm leading-relaxed text-stone-700">
        Part of our Christian Education series in Room 202 (Sundays 11:15 AM – 12:15 PM), exploring how to build deep, meaningful friendships and practice active listening in Christ-centered community.
      </p>
    </div>
  </section>
</BaseLayout>
