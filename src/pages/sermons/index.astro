---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const allSeries = (await getCollection('sermons')).sort((a, b) => a.data.order - b.data.order);
const currentSeries = allSeries.find((s) => s.data.featured) ?? allSeries[0];
const pastSeries = allSeries.filter((s) => s.id !== currentSeries?.id);

const legacySeries = [
  { title: 'Summer 2017', href: 'http://old.thecrossing.website/sermons1707.html' },
  { title: 'Acts (2016–2017)', href: 'http://old.thecrossing.website/sermons1610.html' },
  { title: 'Fall 2016', href: 'http://old.thecrossing.website/sermons1609.html' },
  { title: 'Summer 2016', href: 'http://old.thecrossing.website/sermons1607.html' },
  { title: 'Fall 2015', href: 'http://old.thecrossing.website/sermons1509.html' },
  { title: 'Summer 2015', href: 'http://old.thecrossing.website/sermons1507.html' },
  { title: 'Fall 2014', href: 'http://old.thecrossing.website/sermons1409.html' },
];
---

<BaseLayout title="Sermons" description="Watch current and past sermon series from The Crossing at CFCC Hayward.">
  <PageHeader
    title="Sermons"
    eyebrow="Teaching"
    subtitle="Explore gospel-centered, biblically based messages from Sunday worship at The Crossing."
    backgroundImage="/images/site/hero-sermons.webp"
    breadcrumbs={[{ label: 'Sermons' }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 space-y-16">
    <!-- Current Series Spotlight -->
    {currentSeries && (
      <div>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl font-extrabold text-stone-900">Current Series</h2>
          <a
            href={SITE.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-obsidian px-4 py-2 text-xs font-bold uppercase tracking-wider text-accent hover:bg-slate-dark transition-colors"
          >
            <span>Livestream on YouTube</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="mt-5 overflow-hidden rounded-3xl bg-obsidian text-white shadow-xl lg:grid lg:grid-cols-12">
          <div class="flex items-center justify-center bg-black lg:col-span-7">
            <img
              src={url(currentSeries.data.coverImage)}
              alt={currentSeries.data.title}
              class="h-full w-full object-contain"
            />
          </div>
          <div class="flex flex-col justify-center p-8 lg:col-span-5">
            <span class="inline-block w-fit rounded-full bg-accent/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent">
              {currentSeries.data.book}
            </span>
            <h3 class="mt-3 font-display text-3xl font-extrabold">{currentSeries.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-stone-300">{currentSeries.data.description}</p>
            <div class="mt-6">
              <a
                href={url(`/sermons/${currentSeries.id}`)}
                class="inline-flex items-center rounded-xl bg-accent px-5 py-3 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
              >
                Watch All {currentSeries.data.episodes.length} Messages
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Past Series Grid -->
    <div>
      <h2 class="font-display text-2xl font-extrabold text-stone-900">Past Series</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {pastSeries.map((series) => (
          <SeriesCard
            slug={series.id}
            title={series.data.title}
            book={series.data.book}
            coverImage={series.data.coverImage}
            episodeCount={series.data.episodes.length}
          />
        ))}
      </div>
    </div>

    <!-- Legacy Audio Archive -->
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-xs">
      <h2 class="font-display text-xl font-extrabold text-stone-900">Earlier Sermon Archive (2014–2017)</h2>
      <p class="mt-2 text-sm text-stone-600">
        Older sermon recordings are hosted on our legacy audio archive.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        {legacySeries.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-stone-200 bg-stone-50 px-4 py-2 text-sm font-semibold text-stone-800 hover:border-accent hover:bg-amber-50 transition-colors"
          >
            {item.title} &nearr;
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
