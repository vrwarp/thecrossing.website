---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const allSeries = (await getCollection('sermons')).sort((a, b) => a.data.order - b.data.order);
const currentSeries = allSeries.find((s) => s.data.featured) ?? allSeries[0];
const pastSeries = allSeries.filter((s) => s.id !== currentSeries?.id && s.data.order <= 28);
const archiveSeries = allSeries.filter((s) => s.data.order > 28);
---

<BaseLayout title="Sermons" description="Watch current and past sermon series from The Crossing at CFCC Hayward.">
  <PageHeader
    title="Sermons"
    eyebrow="Teaching"
    subtitle="Explore gospel-centered, biblically based messages from Sunday worship at The Crossing."
    backgroundImage="/images/site/hero-sermons.webp"
    breadcrumbs={[{ label: 'Sermons' }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 space-y-16">
    <!-- Quick Section Jump Bar -->
    <nav aria-label="Sermon sections" class="flex flex-wrap items-center gap-3 border-b border-stone-300 pb-5 font-mono text-xs uppercase tracking-wider">
      <span class="text-stone-500">Jump to:</span>
      <a href="#current-series" class="rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-stone-800 hover:border-stone-900">Current Series</a>
      <a href="#past-series" class="rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-stone-800 hover:border-stone-900">Past Series ({pastSeries.length})</a>
      <a href="#archive-series" class="rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-stone-800 hover:border-stone-900">2006–2018 Archive ({archiveSeries.length})</a>
    </nav>

    <!-- Current Series Spotlight -->
    {currentSeries && (
      <div id="current-series">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl font-extrabold text-stone-900">Current Series</h2>
          <a
            href={SITE.social.youtubeStreams}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-obsidian px-4 py-2 font-mono text-xs font-medium uppercase tracking-wider text-accent hover:bg-slate-dark transition-colors"
          >
            <span>Livestream on YouTube</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="mt-5 overflow-hidden rounded-xl border border-stone-800 bg-obsidian text-white lg:grid lg:grid-cols-12">
          <div class="flex items-center justify-center bg-charcoal p-5 sm:p-8 lg:col-span-7">
            <img
              src={url(currentSeries.data.coverImage)}
              alt={currentSeries.data.title}
              class="w-full rounded-lg object-contain"
            />
          </div>
          <div class="flex flex-col justify-center p-8 lg:col-span-5">
            <span class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent">
              {currentSeries.data.book}
            </span>
            <h3 class="mt-3 font-display text-3xl font-extrabold">{currentSeries.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-stone-300">{currentSeries.data.description}</p>
            <div class="mt-6">
              <a
                href={url(`/sermons/${currentSeries.id}`)}
                class="inline-flex items-center rounded-xl bg-accent px-5 py-3 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
              >
                Watch All {currentSeries.data.episodes.length} Messages
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Podcast Links -->
    <div class="rounded-xl border border-stone-800 bg-obsidian p-8 text-white">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent">Audio Sermons</p>
          <h2 class="mt-1 font-display text-2xl font-extrabold text-white">Listen as a Podcast</h2>
          <p class="mt-1 text-sm text-stone-300">Subscribe to weekly Sunday messages on your favorite podcast app.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          {SITE.podcasts.map((pod) => (
            <a
              href={pod.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition-colors',
                pod.primary
                  ? 'bg-white text-obsidian hover:bg-accent'
                  : 'border border-white/20 text-stone-200 hover:bg-white/10 hover:text-white',
              ]}
            >
              <span>{pod.name}</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Past Series Grid -->
    <div id="past-series">
      <h2 class="font-display text-2xl font-extrabold text-stone-900">Past Series</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {pastSeries.map((series, idx) => (
          <SeriesCard
            slug={series.id}
            title={series.data.title}
            book={[series.data.book, series.data.dateRange].filter(Boolean).join(' • ')}
            coverImage={series.data.coverImage}
            episodeCount={series.data.episodes.length}
            eager={idx < 8}
          />
        ))}
      </div>
    </div>

    <!-- Sermon Archive (2006–2018) -->
    <div id="archive-series">
      <h2 class="font-display text-2xl font-extrabold text-stone-900">Sermon Archive (2006–2018)</h2>
      <p class="mt-1 text-sm text-stone-600">Earlier sermon series and message archives integrated from our church history.</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {archiveSeries.map((series) => (
          <SeriesCard
            slug={series.id}
            title={series.data.title}
            book={[series.data.book, series.data.dateRange].filter(Boolean).join(' • ')}
            coverImage={series.data.coverImage}
            episodeCount={series.data.episodes.length}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
