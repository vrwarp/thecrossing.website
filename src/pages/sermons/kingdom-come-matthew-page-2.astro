---
import { absoluteUrl, url } from '../../lib/url';
const target = url('/sermons/kingdom-come-matthew');
const canonical = absoluteUrl('/sermons/kingdom-come-matthew', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirecting to Kingdom Come</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>Kingdom Come | Matthew</a>...</p>
  </body>
</html>
