---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
---

<BaseLayout
  title="Page Not Found"
  description="The page you requested could not be found on The Crossing website."
  indexable={false}
>
  <PageHeader
    title="Page Not Found"
    eyebrow="404"
    subtitle="We couldn't find the page you were looking for. It may have moved or been updated."
  />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="border-l-2 border-accent pl-6 space-y-4">
      <p class="text-base leading-relaxed text-stone-700">
        Try searching the site or heading back to one of our main sections:
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href={url('/')}
          class="inline-flex items-center rounded-lg bg-obsidian px-5 py-2.5 text-sm font-bold text-white hover:bg-slate-dark transition-colors"
        >
          Back to Home
        </a>
        <a
          href={url('/sermons')}
          class="inline-flex items-center rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-800 hover:bg-stone-100 transition-colors"
        >
          Watch Sermons
        </a>
        <a
          href={url('/im-new')}
          class="inline-flex items-center rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-800 hover:bg-stone-100 transition-colors"
        >
          Plan Your Visit
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
