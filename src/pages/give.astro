---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Give" description="Ways to support the ministry of The Crossing at CFCC Hayward.">
  <PageHeader
    title="Give"
    eyebrow="Generosity"
    subtitle="Thank you for partnering with us to love God, love people, and serve the East Bay and beyond."
    breadcrumbs={[{ label: 'Give' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Ways to Give</p>
      <h2 class="mt-2 font-display text-2xl font-extrabold text-stone-900 sm:text-3xl">
        Supporting ministry <span class="font-serif italic font-normal">together.</span>
      </h2>
    </div>

    <div class="grid divide-y divide-stone-300 border-y border-stone-300 md:grid-cols-3 md:divide-x md:divide-y-0">
      <article class="py-8 md:py-10 md:pr-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / Zero Fee</p>
        <h3 class="font-display text-xl font-bold text-stone-900">Online Banking (Bill Pay)</h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Add <strong>"CFCC Hayward"</strong> as a payee through your bank's Bill Pay with our mailing address:
        </p>
        <p class="rounded-lg border border-stone-300 bg-white px-3 py-2.5 font-mono text-xs font-medium text-stone-800">
          157 Smalley Ave, Hayward, CA 94541
        </p>
        <p class="text-xs text-stone-500">
          If your bank asks for an account number, enter your name or envelope number. You may also specify a fund (e.g., General, Missions) in the memo.
        </p>
      </article>

      <article class="py-8 md:py-10 md:px-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / In Person, Mail, or Zelle</p>
        <h3 class="font-display text-xl font-bold text-stone-900">Check or Zelle</h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Make checks payable to <strong>CFCC Hayward</strong> and drop them in the Sunday offering box or mail to 157 Smalley Ave, Hayward, CA 94541.
        </p>
        <p class="text-xs leading-relaxed text-stone-600">
          <strong>Zelle:</strong> Send to <code class="rounded bg-stone-200/70 px-1.5 py-0.5 font-mono text-[11px] text-stone-900">payments@cfcchayward.org</code> (Chinese for Christ Church of Hayward) with your name and fund designation in the memo.
        </p>
      </article>

      <article class="py-8 md:py-10 md:pl-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">03 / Brokerage Transfer</p>
        <h3 class="font-display text-xl font-bold text-stone-900">Donate Stock</h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Transfer stocks directly to our church’s Wells Fargo brokerage account via your brokerage firm.
        </p>
        <p class="text-xs leading-relaxed text-stone-600">
          Email our finance deacon at{' '}
          <a href="mailto:financecfcch@gmail.com" class="font-semibold text-accent-hover underline">
            financecfcch@gmail.com
          </a>{' '}
          for account info, and include your name, address, stock symbol, number of shares, and date of donation.
        </p>
      </article>
    </div>

    <div class="rounded-xl border border-stone-300 bg-white p-6 text-sm text-stone-600">
      <strong>Tax Receipts &amp; Envelope Numbers:</strong> Need a giving envelope number or have questions about annual tax-deductible contribution statements? Email{' '}
      <a href="mailto:financecfcch@gmail.com" class="font-semibold text-accent-hover underline">financecfcch@gmail.com</a>.
    </div>
  </section>
</BaseLayout>
