---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmbedFrame from '../../components/EmbedFrame.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const calendarEmbed =
  'https://calendar.google.com/calendar/embed?color=%234986e7&color=%237bd148&color=%239fe1e7&color=%23b99aff&color=%23cabdbf&color=%23cca6ac&color=%23fbe983&deb=-&embed_style=WyJhdDplbWI6c3QiLCIjZTBlMGUwIiwiI2VkZWRlZCIsIiM0MTg0ZjMiLCJyb2JvdG8iLCIjNjM2MzYzIiw1MDAsIiNmZmYiXQo&eopt=0&mode=agenda&showCalendars=1&showPrint=0&showTabs=0&showTitle=0&showTz=0&src=79bpk9dptkcanc5mgqo1peirik@group.calendar.google.com&src=growthgroupscore@gmail.com&src=kacp3oilnt7pcnn9bchegc7jvo@group.calendar.google.com&src=kbotfggkikjs94n0snnfmc1blk@group.calendar.google.com&src=m6sf13an5t6t81nacfuno3b23k@group.calendar.google.com&src=r8disfa4um1mkg959bqsr3e0qg@group.calendar.google.com&src=ukbuk9rds072469p64srcmie68@group.calendar.google.com&ctz=America/Los_Angeles';

const announcements = [
  {
    title: 'Membership Class (11/22)',
    date: 'Sunday, Nov 22 • 11:15 AM',
    desc: 'For those learning to follow Jesus, apply for church membership, or be baptized on Thanksgiving Sunday (11/29), this 3-week class concludes with P. Josh, 11:15 AM this Sunday in Room 201.',
    actionLabel: 'Email Church Office',
    actionHref: 'mailto:church.office@cfcchayward.org?subject=Membership%20Class',
  },
  {
    title: 'Thanksgiving Celebration Dinner and Fellowship (11/21)',
    date: 'Saturday, Nov 21 • 5:00 PM',
    desc: 'Join us Saturday for a 5 PM potluck dinner, followed by programs 6:30–8 PM for children, youth, and The Crossing. Sign up online to bring a dish, or donate $5. Volunteers welcome to help set up chairs and tables at 4:15 PM (contact Bonnie, General Affairs Deacon).',
    actionLabel: 'Potluck Sign-Up Link',
    actionHref: 'https://docs.google.com/forms/d/e/1FAIpQLSdhDQL0k-qcjfJB8wVcy-IebLlu4vrdaYuOytE8OhfsWxpfvQ/viewform?usp=preview',
  },
  {
    title: 'BG Thanksgiving Delivery (11/22)',
    date: 'Sunday, Nov 22 • 11:15 AM',
    desc: 'During this season of Thanksgiving and with some food programs facing uncertainty, Bridging Grace invites you to share Jesus’ love through extra support for our neighbors in need. Pray, donate, or serve at our Annual Thanksgiving Delivery Day at 11:15 AM in the Youth Center. Sign up to volunteer with Lori de St. Aubin, or if you know someone in need contact Mindy at bridginggrace@gmail.com.',
    actionLabel: 'Email Bridging Grace',
    actionHref: 'mailto:bridginggrace@gmail.com?subject=Bridging%20Grace%20Delivery',
  },
  {
    title: 'Quarterly Break (11/25–28)',
    date: 'Nov 25 – Nov 28',
    desc: 'There are no official fellowship or Growth Group gatherings next week due to the holiday break. Join us for Thanksgiving worship & baptisms at 9:30 AM next Sunday, 11/29.',
  },
  {
    title: 'Alameda Food Bank (11/29 – 1/3)',
    date: 'Nov 29 – Jan 3',
    desc: 'Donate canned or dried pantry goods to bless families in need this holiday season. Red collection barrels will be located in the Lobby and Fellowship Hall.',
    actionLabel: 'See Serving Teams',
    actionHref: url('/get-connected/serve'),
  },
  {
    title: 'Hospitality Meeting (12/6)',
    date: 'Sunday, Dec 6 • 11:15 AM – 12:15 PM',
    desc: 'All team members, please attend this training and appreciation in Room 107, 11:15 AM – 12:15 PM that Sunday.',
    actionLabel: 'Join Hospitality Team',
    actionHref: url('/get-connected/serve'),
  },
];
---

<BaseLayout title="Events" description="Upcoming events, Sunday worship, Christian Education, and church announcements at The Crossing.">
  <PageHeader
    title="Upcoming Events"
    eyebrow="Calendar & News"
    subtitle="Stay connected with what's happening across The Crossing — Sunday gatherings, classes, retreats, and community outreach."
    backgroundImage="/images/community/church-family-picnic.webp"
    breadcrumbs={[{ label: 'Events' }]}
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 space-y-14">
    <!-- Featured Retreats -->
    <div class="space-y-6">
      <div class="rounded-xl border border-stone-800 bg-obsidian overflow-clip text-white lg:grid lg:grid-cols-12 lg:items-center">
        <div class="p-8 sm:p-10 lg:col-span-8 space-y-3">
          <span class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent">
            Youth Winter Camp &bull; Feb 12–15, 2027
          </span>
          <h2 class="font-display text-2xl font-extrabold sm:text-3xl">
            Bigfoot 2027: <span class="font-serif italic font-normal text-amber-300">Youth Retreat at Redwood Glen</span>
          </h2>
          <p class="text-sm text-stone-300 sm:text-base">
            4 days &amp; 3 nights over President's Day Weekend for Grades 6–12. Early Bird ($125) ends Dec 14.
          </p>
          <div class="pt-2">
            <a
              href={url('/events/bigfoot')}
              class="inline-flex items-center rounded-xl bg-accent px-6 py-3 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
            >
              View Bigfoot Details &amp; Register &rarr;
            </a>
          </div>
        </div>
        <div class="h-48 lg:h-full lg:col-span-4">
          <img
            src={url('/images/events/bigfoot-camp.webp')}
            alt="Redwood Glen cabin surrounded by redwood trees"
            loading="eager"
            decoding="sync"
            class="h-full w-full object-cover object-[20%_55%]"
          />
        </div>
      </div>

      <div class="rounded-xl border border-stone-800 bg-obsidian p-8 text-white sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-8">
        <div class="max-w-2xl">
          <span class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent">
            Featured Retreat &bull; Nov 6–8, 2026
          </span>
          <h2 class="mt-3 font-display text-2xl font-extrabold sm:text-3xl">
            Men's Retreat: <span class="font-serif italic font-normal text-amber-300">On Point — Kingdom Manhood</span>
          </h2>
          <p class="mt-2 text-sm text-stone-300 sm:text-base">
            Redwood Glen Conference Center, Loma Mar CA &bull; Guest Speaker: Pastor Matthew "Matty" Blevins.
          </p>
        </div>
        <div class="mt-6 lg:mt-0 shrink-0">
          <a
            href={url('/events/mens-retreat')}
            class="inline-flex items-center rounded-xl border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
          >
            View Retreat Details &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Weekly Schedule -->
    <div class="grid divide-y divide-stone-300 border-y border-stone-300 md:grid-cols-2 md:divide-x md:divide-y-0">
      <div class="py-8 md:pr-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / Weekly Worship</p>
        <h3 class="font-display text-xl font-bold text-stone-900">Join Us Sundays at 9:30 AM</h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Worship together with us every Sunday at 157 Smalley Ave, Hayward. We also livestream on our{' '}
          <a href={SITE.social.youtubeStreams} target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-hover underline">YouTube Channel</a> for those experiencing hardship to attend in-person.
        </p>
      </div>
      <div class="py-8 md:pl-8 space-y-3">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / Sundays at 11:15 AM</p>
        <h3 class="font-display text-xl font-bold text-stone-900">Christian Education Classes</h3>
        <ul class="space-y-1 text-sm text-stone-600">
          <li><strong>Adult CE Class:</strong> 11:15 AM &bull; Room 202</li>
          <li><strong>High School CE Class:</strong> 11:15 AM &bull; Room 204</li>
          <li><strong>Middle School CE Class:</strong> 11:15 AM &bull; Room 201</li>
        </ul>
        <a href={url('/resources/ce')} class="inline-block font-mono text-xs font-medium uppercase tracking-wider text-accent-hover hover:underline pt-1">
          View CE Schedule &rarr;
        </a>
      </div>
    </div>

    <!-- Announcements -->
    <div>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-hover">Church News</p>
          <h2 class="mt-1 font-display text-2xl font-extrabold text-stone-900">Announcements</h2>
        </div>
        <a href={url('/contact-us')} class="font-mono text-xs font-medium uppercase tracking-wider text-accent-hover hover:underline">
          Questions or RSVP? Contact us &rarr;
        </a>
      </div>
      <div class="mt-6 divide-y divide-stone-300 border-y border-stone-300">
        {announcements.map((item) => (
          <article class="grid gap-3 py-6 sm:grid-cols-12 sm:items-baseline sm:gap-6">
            <p class="font-mono text-xs font-medium uppercase tracking-wider text-accent-hover sm:col-span-3">{item.date}</p>
            <div class="sm:col-span-6">
              <h3 class="font-display text-lg font-bold text-stone-900">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-stone-600">{item.desc}</p>
            </div>
            <div class="sm:col-span-3 sm:text-right">
              {item.actionHref && item.actionLabel && (
                <a href={item.actionHref} class="inline-block font-mono text-xs font-medium uppercase tracking-wider text-stone-900 hover:text-accent-hover">
                  {item.actionLabel} &rarr;
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
    <!-- Family Care, Prayer & Lobby Resources -->
    <div class="grid divide-y divide-stone-300 border-y border-stone-300 md:grid-cols-3 md:divide-x md:divide-y-0">
      <div class="py-7 md:pr-7 space-y-2">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">Congratulations</p>
        <h3 class="font-display text-lg font-bold text-stone-900">New Babies at The Crossing</h3>
        <p class="text-sm leading-relaxed text-stone-600">
          To Will and Eva on the birth of Savannah Yee, and YJ and Stef on the birth of Rainier Tung! Please keep them in prayer. Provide a meal via{' '}
          <a href="https://www.mealtrain.com/trains/8z7732" target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-hover underline">Yee Family Meal Train</a>{' '}
          or{' '}
          <a href="https://www.mealtrain.com/trains/z6gyzd" target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-hover underline">Tung Family Meal Train</a>.
        </p>
      </div>
      <div class="py-7 md:px-7 space-y-2">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">Pray For</p>
        <h3 class="font-display text-lg font-bold text-stone-900">Church Prayer</h3>
        <p class="text-sm leading-relaxed text-stone-600">
          Footprints youth counselors; those struggling with grief &amp; loss; a spirit of thankfulness; new babies at The Crossing.
        </p>
      </div>
      <div class="py-7 md:pl-7 space-y-2">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">Growth Resources</p>
        <h3 class="font-display text-lg font-bold text-stone-900">Books &amp; Bibles in the Lobby</h3>
        <p class="text-sm leading-relaxed text-stone-600">
          We offer a selection of books in the Lobby to encourage your growth in Christ, including ESV Bibles and daily devotional material (free for visitors, or with a donation of any amount for members).
        </p>
      </div>
    </div>

    <!-- Church Calendar -->
    <div>
      <h2 class="mb-4 font-display text-2xl font-extrabold text-stone-900">Church Calendar</h2>
      <EmbedFrame
        src={calendarEmbed}
        title="The Crossing Church Calendar"
        heightClass="h-[580px]"
        openLabel="Open Calendar"
      />
    </div>
  </section>
</BaseLayout>
