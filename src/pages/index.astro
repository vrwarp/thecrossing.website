---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import EmbedFrame from '../components/EmbedFrame.astro';
import { SITE } from '../data/site';
import { url } from '../lib/url';

const allSeries = (await getCollection('sermons')).sort((a, b) => a.data.order - b.data.order);
const currentSeries = allSeries.find((s) => s.data.featured) ?? allSeries[0];
const recentSeries = allSeries.filter((s) => s.id !== currentSeries?.id).slice(0, 3);

const ministries = [
  {
    title: 'Growth Groups',
    subtitle: 'Cross-Generational',
    description: 'Weekly home Bible studies to grow transformationally in Christ, relationally in His family, and missionally in the East Bay.',
    href: '/get-connected/growth-groups',
    image: '/images/community/growth-group-home.webp',
  },
  {
    title: 'Children (The Rock)',
    subtitle: 'Nursery – 5th Grade',
    description: 'Fun, safe, gospel-centered Sunday morning and Friday night (Shining Stars) programs where kids encounter and know Jesus.',
    href: '/get-connected/children',
    image: '/images/community/children-class.webp',
  },
  {
    title: 'Youth (Footprints)',
    subtitle: 'Grades 6–12 • Fridays 7:30 PM',
    description: 'Wild games, real friendship, and honest conversations about life and God on the 2nd floor Youth Center.',
    href: '/get-connected/youth',
    image: '/images/community/youth-hangout.webp',
  },
  {
    title: 'Young Adults (Transparent)',
    subtitle: 'College & Career • Thursdays 7:45 PM',
    description: 'A community of young adults meeting in Room 107 to study, worship, pray, and live out a visible faith.',
    href: '/get-connected/young-adults',
    image: '/images/community/young-adults-park.webp',
  },
  {
    title: 'Mature Adults',
    subtitle: 'Fridays 7:30 PM',
    description: 'Support, encouragement, Bible study, and prayer for married or single adults and parents in Room 107.',
    href: '/get-connected/mature-adults',
    image: '/images/community/mature-adults-group.webp',
  },
  {
    title: 'Discipleship',
    subtitle: '1-on-1 Mentoring',
    description: 'Intentional 10-month discipleship pairs growing together in learning, sharing, and prayer.',
    href: '/get-connected/discipleship',
    image: '/images/community/discipleship-bible.webp',
  },
];

const values = [
  "Experience God's Truth",
  'Reach People',
  'Authentic Community',
  'Maximize Involvement',
  'Family Across Generations & Cultures',
  'Worship God',
];
---

<BaseLayout title={SITE.name}>
  <!-- Editorial Asymmetric Dark Hero -->
  <section class="relative overflow-clip bg-obsidian text-white border-b border-white/10">
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent">
            Sundays 9:30 AM &bull; 157 Smalley Ave, Hayward
          </p>

          <h1 class="mt-5 font-display text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-[4.25rem] lg:leading-[1.04]">
            Crossing generations &amp; cultures{' '}
            <span class="font-serif font-normal italic text-accent">together in Christ.</span>
          </h1>

          <p class="mt-6 max-w-xl text-base leading-relaxed text-stone-300 sm:text-lg">
            We are a church from singles to families, with a heart to be multi-generational and multicultural—connecting to God in authentic worship and to people in genuine relationships.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a
              href={url('/im-new')}
              class="inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3.5 text-sm font-bold text-obsidian transition-colors hover:bg-accent-hover"
            >
              Plan Your Visit
            </a>
            <a
              href={url('/sermons')}
              class="inline-flex items-center justify-center rounded-lg border border-white/25 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
            >
              Watch Sermons
            </a>
            <a
              href={url('/get-connected')}
              class="inline-flex items-center px-2 py-2 font-mono text-xs font-medium uppercase tracking-wider text-stone-300 transition-colors hover:text-accent"
            >
              Get Connected &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative overflow-clip rounded-2xl border border-white/15 bg-charcoal shadow-2xl">
            <div class="aspect-[4/3] w-full overflow-clip">
              <img
                src={url('/images/site/hero-sanctuary.webp')}
                alt="Sunday worship gathering at The Crossing in Hayward"
                fetchpriority="high"
                decoding="sync"
                class="parallax-media h-full w-full object-cover"
              />
            </div>
            <div class="flex items-center justify-between border-t border-white/10 px-5 py-3.5 text-xs">
              <span class="font-mono uppercase tracking-wider text-stone-300">Main Sanctuary</span>
              <a href={url('/im-new/our-campus')} class="font-semibold text-accent hover:underline">
                Campus &amp; Parking &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hairline-Ruled First-Time Visitor Index (Anti-Template) -->
  <section class="border-b border-stone-300 bg-stone-50">
    <div class="mx-auto grid max-w-7xl divide-y divide-stone-300 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div class="p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <p class="font-mono text-xs font-semibold tracking-widest text-accent-hover">01 / SUNDAY GATHERING</p>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900">9:30 AM Every Week</h2>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">
            Service runs 9:30–10:45 AM, followed by refreshments (10:45–11:15 AM), Christian Education (11:15 AM–12:30 PM), and lunch at church.
          </p>
        </div>
        <a href={url('/im-new')} class="mt-4 inline-block font-mono text-xs font-semibold uppercase tracking-wider text-stone-900 hover:text-accent-hover">
          Plan your visit &rarr;
        </a>
      </div>
      <div class="p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <p class="font-mono text-xs font-semibold tracking-widest text-accent-hover">02 / LOCATION &amp; PARKING</p>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900">157 Smalley Ave</h2>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">
            Lot A has visitor and handicap parking; regular attendees park in Lot C. Signs and greeters will help direct you.
          </p>
        </div>
        <a href={url('/im-new/our-campus')} class="mt-4 inline-block font-mono text-xs font-semibold uppercase tracking-wider text-stone-900 hover:text-accent-hover">
          Campus &amp; parking &rarr;
        </a>
      </div>
      <div class="p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <p class="font-mono text-xs font-semibold tracking-widest text-accent-hover">03 / FOR FAMILIES</p>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900">Kids &amp; Youth</h2>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">
            Safe nursery–5th grade at The Rock (Sundays 9:30 AM), plus Footprints Youth (Grades 6–12) on Fridays &amp; Sundays.
          </p>
        </div>
        <div class="mt-4 flex flex-wrap gap-4 font-mono text-xs font-semibold uppercase tracking-wider">
          <a href={url('/get-connected/children')} class="text-stone-900 hover:text-accent-hover">The Rock Kids &rarr;</a>
          <a href={url('/get-connected/youth')} class="text-stone-900 hover:text-accent-hover">Footprints Youth &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Life Together Bento Gallery -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-hover">Life Together</p>
        <h2 class="mt-2 font-serif text-3xl italic text-stone-900 sm:text-5xl">
          A multi-generational family in the East Bay.
        </h2>
      </div>
      <a href={url('/im-new/our-church')} class="text-sm font-bold text-stone-900 hover:text-accent-hover transition-colors">
        Our story &amp; values &rarr;
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-12">
      <div class="relative overflow-clip rounded-2xl md:col-span-7 aspect-[16/11] md:aspect-auto md:min-h-[380px]">
        <img
          src={url('/images/community/cross-gen-redwoods.webp')}
          alt="Multi-generational church family together at The Crossing"
          loading="lazy"
          decoding="async"
          class="parallax-media h-full w-full object-cover object-[50%_45%]"
        />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-obsidian via-obsidian/85 to-transparent p-6 pt-16">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-amber-300">Family Across Generations</p>
          <p class="mt-1 font-display text-lg font-bold text-white">From nursery to grandparents, growing together in Hayward.</p>
        </div>
      </div>

      <div class="grid gap-4 md:col-span-5 grid-cols-2 md:grid-cols-1">
        <div class="relative overflow-clip rounded-2xl aspect-[16/10]">
          <img
            src={url('/images/community/growth-group-home.webp')}
            alt="Cross-generational Growth Group celebrating together at home"
            loading="lazy"
            decoding="async"
            class="parallax-media h-full w-full object-cover object-center"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-obsidian/90 via-obsidian/50 to-transparent p-4 pt-10">
            <p class="font-display text-sm font-bold text-white">Authentic Home Community</p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="relative overflow-hidden rounded-xl aspect-square">
            <img
              src={url('/images/community/moms-and-toddler.webp')}
              alt="Parents and young child smiling at church event"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-obsidian/95 via-obsidian/55 to-transparent p-3 pt-10">
              <p class="font-mono text-[11px] font-medium uppercase tracking-wider text-white">Kids &amp; Parents</p>
            </div>
          </div>
          <div class="relative overflow-hidden rounded-xl aspect-square">
            <img
              src={url('/images/community/youth-group-cross.webp')}
              alt="Footprints Youth Group and leaders together at The Crossing"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-obsidian/95 via-obsidian/55 to-transparent p-3 pt-10">
              <p class="font-mono text-[11px] font-medium uppercase tracking-wider text-white">Youth &amp; Disciplers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Teaching / Sermons -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="flex flex-col justify-between gap-4 border-b border-stone-300 pb-6 sm:flex-row sm:items-end">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-hover">Teaching</p>
        <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
          Latest Sermon Series
        </h2>
      </div>
      <a
        href={url('/sermons')}
        class="inline-flex items-center gap-1.5 text-sm font-bold text-stone-900 hover:text-accent-hover transition-colors"
      >
        <span>Browse all {allSeries.length} series</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    {currentSeries && (
      <div class="mt-8 overflow-hidden rounded-2xl bg-obsidian text-white shadow-xl lg:grid lg:grid-cols-12">
        <div class="flex items-center justify-center bg-charcoal p-5 sm:p-8 lg:col-span-7">
          <img
            src={url(currentSeries.data.coverImage)}
            alt={currentSeries.data.title}
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl object-contain shadow-lg"
          />
        </div>
        <div class="flex flex-col justify-center p-8 lg:col-span-5 lg:p-10">
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">
            Current Series &bull; {currentSeries.data.book}
          </span>
          <h3 class="mt-3 font-display text-2xl font-extrabold text-white sm:text-3xl">
            {currentSeries.data.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-stone-300 sm:text-base">
            {currentSeries.data.description}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={url(`/sermons/${currentSeries.id}`)}
              class="inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
            >
              Watch Series ({currentSeries.data.episodes.length} messages)
            </a>
            <a
              href={SITE.social.youtubeStreams}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg border border-white/20 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
            >
              Sunday Livestream
            </a>
          </div>
        </div>
      </div>
    )}

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recentSeries.map((series) => (
        <SeriesCard
          slug={series.id}
          title={series.data.title}
          book={series.data.book}
          coverImage={series.data.coverImage}
          episodeCount={series.data.episodes.length}
        />
      ))}
    </div>
  </section>

  <!-- Editorial Vision & Values Dark Band -->
  <section class="relative overflow-clip bg-obsidian py-20 text-white sm:py-24">
    <img
      src={url('/images/site/worship-stage.webp')}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="parallax-media absolute inset-0 h-full w-full object-cover opacity-10"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-obsidian via-obsidian/95 to-obsidian/80"
      aria-hidden="true"
    />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-7">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">Our Vision</p>
          <blockquote class="mt-4 font-serif text-3xl italic leading-snug text-white sm:text-5xl">
            “THE CROSSING is an English-speaking, multiethnic ministry crossing generations and cultures together in Christ to love God, love people, and serve the world.”
          </blockquote>
          <p class="mt-6 text-base leading-relaxed text-stone-300">
            As the English-speaking ministry of Chinese For Christ Church of Hayward, we serve Hayward, Castro Valley, San Leandro, San Lorenzo, Union City, and beyond with a heart to cross generations and cultures in Christ.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href={url('/im-new/our-church')}
              class="inline-flex items-center rounded-lg bg-white px-5 py-3 text-sm font-bold text-obsidian hover:bg-stone-200 transition-colors"
            >
              About Our Church
            </a>
            <a
              href={url('/im-new/our-beliefs')}
              class="inline-flex items-center rounded-lg border border-white/25 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
            >
              What We Believe
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 border-t border-white/15 lg:border-t-0 lg:border-l lg:pl-10 pt-8 lg:pt-0">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-stone-400">Six Core Values</p>
          <ol class="mt-4 divide-y divide-white/15">
            {values.map((val, idx) => (
              <li class="flex items-baseline gap-4 py-3.5">
                <span class="font-mono text-xs font-semibold text-accent">0{idx + 1}</span>
                <span class="font-display text-base font-semibold text-white">{val}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Asymmetric Editorial Get Connected Showcase (Breaks 3x2 SaaS Card Grid) -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-4 lg:sticky lg:top-24 space-y-5">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-hover">Community</p>
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
          Connect with <span class="font-serif font-normal italic">our church family.</span>
        </h2>
        <p class="text-base leading-relaxed text-stone-600">
          Explore our weekly ministries for children, youth, young adults, adult Growth Groups, and discipleship.
        </p>
        <div class="flex flex-col gap-2.5 pt-2 text-sm font-bold">
          <a href={url('/get-connected/serve')} class="text-accent-hover hover:underline">
            Serve on a Sunday or outreach team &rarr;
          </a>
          <a href={url('/resources/after-school-program')} class="text-stone-900 hover:text-accent-hover transition-colors">
            Free Kids Homework Club (K–7th) &rarr;
          </a>
          <a href={url('/events')} class="text-stone-900 hover:text-accent-hover transition-colors">
            View upcoming events &amp; calendar &rarr;
          </a>
          <a href={url('/get-connected')} class="text-stone-900 hover:text-accent-hover transition-colors">
            Explore all ministries &rarr;
          </a>
        </div>
      </div>

      <div class="lg:col-span-8 grid gap-6 sm:grid-cols-2">
        {ministries.map((m) => (
          <a
            href={url(m.href)}
            class="group flex flex-col justify-between overflow-hidden rounded-xl border border-stone-300 bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-stone-900"
          >
            <div>
              <div class="aspect-[16/10] w-full overflow-hidden bg-stone-100">
                <img
                  src={url(m.image)}
                  alt={m.title}
                  loading="lazy"
                  decoding="async"
                  class={`h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 ${m.image.includes('youth-') || m.image.includes('children-') ? 'object-top' : m.image.includes('cross-gen-redwoods') ? 'object-[50%_45%]' : 'object-center'}`}
                />
              </div>
              <div class="p-5 pb-2">
                <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-accent-hover">{m.subtitle}</p>
                <h3 class="mt-1.5 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
                  {m.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-stone-600">{m.description}</p>
              </div>
            </div>
            <p class="px-5 pb-5 pt-3 font-mono text-xs font-semibold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
              Learn more &rarr;
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Location & Map -->
  <section class="border-t border-stone-300 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5 space-y-4">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-hover">Visit Us</p>
          <h2 class="font-display text-3xl font-extrabold tracking-tight text-stone-900">
            Join Us This Sunday
          </h2>
          <p class="text-base leading-relaxed text-stone-600">
            We gather every Sunday at <strong>9:30 AM</strong> at Chinese For Christ Church of Hayward. Come as you are!
          </p>
          <div class="space-y-2 pt-2 text-sm text-stone-700">
            <p><strong>Address:</strong> {SITE.address.full}</p>
            <p><strong>Phone:</strong> <a href={SITE.phoneHref} class="underline hover:text-accent-hover">{SITE.phone}</a></p>
            <p><strong>Email:</strong> <a href={`mailto:${SITE.email}`} class="underline hover:text-accent-hover">{SITE.email}</a></p>
          </div>
          <div class="flex flex-wrap gap-3 pt-3">
            <a
              href={SITE.address.mapsQuery}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg bg-obsidian px-5 py-3 text-sm font-bold text-white hover:bg-slate-dark transition-colors"
            >
              Get Directions
            </a>
            <a
              href={url('/im-new/our-campus')}
              class="inline-flex items-center rounded-lg border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-800 hover:bg-stone-100 transition-colors"
            >
              Parking &amp; Campus Map
            </a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <EmbedFrame
            src={SITE.address.mapsEmbed}
            title="157 Smalley Ave, Hayward, CA"
            heightClass="h-[360px]"
            openLabel="Open in Google Maps"
            openHref={SITE.address.mapsQuery}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
