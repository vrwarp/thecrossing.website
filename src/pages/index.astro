---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import EmbedFrame from '../components/EmbedFrame.astro';
import { SITE } from '../data/site';
import { url } from '../lib/url';

const allSeries = (await getCollection('sermons')).sort((a, b) => a.data.order - b.data.order);
const currentSeries = allSeries.find((s) => s.data.featured) ?? allSeries[0];
const recentSeries = allSeries.filter((s) => s.id !== currentSeries?.id).slice(0, 6);

const ministries = [
  {
    title: 'Growth Groups',
    subtitle: 'Cross-Generational',
    description: 'Weekly home Bible studies to grow transformationally in Christ, relationally in His family, and missionally in the East Bay.',
    href: '/get-connected/growth-groups',
  },
  {
    title: 'Children (The Rock)',
    subtitle: 'Nursery – 5th Grade',
    description: 'Fun, safe, gospel-centered Sunday morning and Friday night programs where kids encounter and know Jesus.',
    href: '/get-connected/children',
  },
  {
    title: 'Youth (Footprints)',
    subtitle: 'Grades 6–12 • Fridays 7:30 PM',
    description: 'Wild games, real friendship, and honest conversations about life and God on the 2nd floor Youth Center.',
    href: '/get-connected/youth',
  },
  {
    title: 'Young Adults (Transparent)',
    subtitle: 'College & Career • Thursdays 7:45 PM',
    description: 'A community of young adults meeting in Room 107 to study, worship, pray, and live out a visible faith.',
    href: '/get-connected/young-adults',
  },
  {
    title: 'Mature Adults',
    subtitle: 'Fridays 7:30 PM',
    description: 'Support, encouragement, Bible study, and prayer for married or single adults and parents in Room 107.',
    href: '/get-connected/mature-adults',
  },
  {
    title: 'Discipleship',
    subtitle: '1-on-1 Mentoring',
    description: 'Intentional 10-month discipleship pairs growing together in learning, sharing, and prayer.',
    href: '/get-connected/discipleship',
  },
];

const values = [
  "Experience God's Truth",
  'Reach People',
  'Authentic Community',
  'Maximize Involvement',
  'Family Across Generations & Cultures',
  'Worship God',
];
---

<BaseLayout title={SITE.name}>
  <!-- Bold Contemporary Dark Hero -->
  <section class="relative overflow-hidden bg-obsidian text-white">
    <img
      src={url('/images/site/hero-sanctuary.webp')}
      alt="Sunday worship gathering at The Crossing in Hayward"
      fetchpriority="high"
      decoding="sync"
      class="absolute inset-0 h-full w-full object-cover object-center opacity-45"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/70 to-obsidian/50"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute -top-32 right-1/4 h-96 w-96 rounded-full bg-accent/15 blur-3xl"
      aria-hidden="true"
    />

    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8 lg:py-40">
      <div class="max-w-3xl">
        <p class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent backdrop-blur-xs">
          <span>{SITE.serviceTime}</span>
          <span aria-hidden="true">&bull;</span>
          <span>157 Smalley Ave, Hayward</span>
        </p>

        <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl">
          Cross generations &amp; cultures together in Christ.
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-relaxed text-stone-300 sm:text-xl">
          We’re a vibrant, multiethnic church in the East Bay—connecting to God in authentic worship and to people in genuine relationships.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href={url('/im-new')}
            class="inline-flex items-center justify-center rounded-xl bg-accent px-6 py-3.5 text-sm font-bold text-obsidian shadow-lg transition-all duration-150 hover:-translate-y-0.5 hover:bg-accent-hover"
          >
            Plan Your Visit
          </a>
          <a
            href={url('/sermons')}
            class="inline-flex items-center justify-center rounded-xl border border-white/25 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur-xs transition-colors hover:bg-white/15"
          >
            Watch Sermons
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- First-Time Visitor Quick Strip -->
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto grid max-w-7xl divide-y divide-stone-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div class="p-6 sm:p-8">
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">Sunday Gathering</p>
        <h2 class="mt-1.5 font-display text-xl font-bold text-stone-900">9:30 AM Every Week</h2>
        <p class="mt-2 text-sm leading-relaxed text-stone-600">
          75-minute service with live worship, biblical teaching, and space to meet new friends.
        </p>
      </div>
      <div class="p-6 sm:p-8">
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">Location &amp; Parking</p>
        <h2 class="mt-1.5 font-display text-xl font-bold text-stone-900">157 Smalley Ave</h2>
        <p class="mt-2 text-sm leading-relaxed text-stone-600">
          Reserved visitor parking in our main campus lots. Greeters will welcome you at the door.
        </p>
      </div>
      <div class="p-6 sm:p-8">
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">For Families</p>
        <h2 class="mt-1.5 font-display text-xl font-bold text-stone-900">The Rock Kids</h2>
        <p class="mt-2 text-sm leading-relaxed text-stone-600">
          Safe, engaging nursery through 5th grade programs during Sunday worship at 9:30 AM.
        </p>
      </div>
    </div>
  </section>

  <!-- Latest Teaching / Sermons -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">Teaching</p>
        <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
          Latest Sermon Series
        </h2>
      </div>
      <a
        href={url('/sermons')}
        class="inline-flex items-center gap-1.5 text-sm font-bold text-stone-900 hover:text-accent-hover transition-colors"
      >
        <span>Browse all {allSeries.length} series</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    {currentSeries && (
      <div class="mt-8 overflow-hidden rounded-3xl bg-obsidian text-white shadow-xl lg:grid lg:grid-cols-12">
        <div class="relative flex items-center justify-center bg-black lg:col-span-7">
          <img
            src={url(currentSeries.data.coverImage)}
            alt={currentSeries.data.title}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </div>
        <div class="flex flex-col justify-center p-8 lg:col-span-5 lg:p-10">
          <span class="inline-block w-fit rounded-full bg-accent/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent">
            Current Series &bull; {currentSeries.data.book}
          </span>
          <h3 class="mt-4 font-display text-2xl font-extrabold text-white sm:text-3xl">
            {currentSeries.data.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-stone-300 sm:text-base">
            {currentSeries.data.description}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={url(`/sermons/${currentSeries.id}`)}
              class="inline-flex items-center rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
            >
              Watch Series ({currentSeries.data.episodes.length} messages)
            </a>
            <a
              href={SITE.social.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-xl border border-white/20 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
            >
              Sunday Livestream
            </a>
          </div>
        </div>
      </div>
    )}

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recentSeries.map((series) => (
        <SeriesCard
          slug={series.id}
          title={series.data.title}
          book={series.data.book}
          coverImage={series.data.coverImage}
          episodeCount={series.data.episodes.length}
        />
      ))}
    </div>
  </section>

  <!-- Vision & Values Dark Band -->
  <section class="relative overflow-hidden bg-obsidian py-20 text-white sm:py-24">
    <img
      src={url('/images/site/worship-stage.webp')}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-20"
    />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-accent">Our Vision</p>
        <h2 class="mt-3 font-display text-2xl font-extrabold leading-tight text-white sm:text-4xl">
          “THE CROSSING is an English-speaking, multiethnic ministry crossing generations and cultures together in Christ to love God, love people, and serve the world.”
        </h2>
        <p class="mt-4 text-base leading-relaxed text-stone-300">
          Originally founded as part of Chinese For Christ Church of Hayward, we’ve grown into a multicultural family serving Hayward, Castro Valley, San Leandro, San Lorenzo, Union City, and beyond.
        </p>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {values.map((val, idx) => (
          <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3.5 backdrop-blur-xs">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-extrabold text-obsidian">
              {idx + 1}
            </span>
            <span class="text-sm font-semibold text-white">{val}</span>
          </div>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={url('/im-new/our-church')}
          class="inline-flex items-center rounded-xl bg-white px-5 py-3 text-sm font-bold text-obsidian hover:bg-stone-200 transition-colors"
        >
          About Our Church
        </a>
        <a
          href={url('/im-new/our-beliefs')}
          class="inline-flex items-center rounded-xl border border-white/25 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
        >
          What We Believe
        </a>
      </div>
    </div>
  </section>

  <!-- Get Connected / Ministries -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">Community</p>
        <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
          Get Connected
        </h2>
        <p class="mt-2 max-w-xl text-base text-stone-600">
          Life is better together. Find a weekly group for your season of life.
        </p>
      </div>
      <a
        href={url('/get-connected')}
        class="inline-flex items-center gap-1.5 text-sm font-bold text-stone-900 hover:text-accent-hover transition-colors"
      >
        <span>Explore all ministries</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {ministries.map((m) => (
        <a
          href={url(m.href)}
          class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
        >
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-accent-hover">{m.subtitle}</p>
            <h3 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
              {m.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{m.description}</p>
          </div>
          <p class="mt-5 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
            Learn more &rarr;
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Location & Map -->
  <section class="border-t border-stone-200 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5 space-y-4">
          <p class="text-xs font-bold uppercase tracking-widest text-accent-hover">Visit Us</p>
          <h2 class="font-display text-3xl font-extrabold tracking-tight text-stone-900">
            Join Us This Sunday
          </h2>
          <p class="text-base leading-relaxed text-stone-600">
            We gather every Sunday at <strong>9:30 AM</strong> at Chinese For Christ Church of Hayward. Come as you are!
          </p>
          <div class="space-y-2 pt-2 text-sm text-stone-700">
            <p><strong>Address:</strong> {SITE.address.full}</p>
            <p><strong>Phone:</strong> <a href={SITE.phoneHref} class="underline hover:text-accent-hover">{SITE.phone}</a></p>
            <p><strong>Email:</strong> <a href={`mailto:${SITE.email}`} class="underline hover:text-accent-hover">{SITE.email}</a></p>
          </div>
          <div class="flex flex-wrap gap-3 pt-3">
            <a
              href={SITE.address.mapsQuery}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-xl bg-obsidian px-5 py-3 text-sm font-bold text-white hover:bg-slate-dark transition-colors"
            >
              Get Directions
            </a>
            <a
              href={url('/im-new/our-campus')}
              class="inline-flex items-center rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-800 hover:bg-stone-100 transition-colors"
            >
              Parking &amp; Campus Map
            </a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <EmbedFrame
            src={SITE.address.mapsEmbed}
            title="157 Smalley Ave, Hayward, CA"
            heightClass="h-[360px]"
            openLabel="Open in Google Maps"
            openHref={SITE.address.mapsQuery}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
