---
import { url } from '../lib/url';

const bundlePath = url('/pagefind/');
---

<dialog
  id="search-dialog"
  class="m-auto w-full max-w-2xl rounded-2xl border border-stone-200 bg-white p-0 shadow-2xl backdrop:bg-obsidian/80 backdrop:backdrop-blur-xs"
>
  <div class="flex items-center justify-between border-b border-stone-200 px-5 py-4">
    <h2 class="font-display text-base font-bold text-stone-900">Search The Crossing</h2>
    <button
      type="button"
      id="search-close"
      class="rounded-lg p-1.5 text-stone-500 hover:bg-stone-100 hover:text-stone-900"
      aria-label="Close search"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="p-5 max-h-[70vh] overflow-y-auto">
    <div id="pagefind-search" data-bundle-path={bundlePath}></div>
  </div>
</dialog>

<script>
  const searchDialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('search-close');
  let initialized = false;

  async function initPagefind() {
    if (initialized) return;
    initialized = true;
    const container = document.getElementById('pagefind-search');
    const bundlePath = container?.getAttribute('data-bundle-path') || '/pagefind/';
    try {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = `${bundlePath}pagefind-ui.css`;
      document.head.appendChild(link);

      const { PagefindUI } = await import(/* @vite-ignore */ `${bundlePath}pagefind-ui.js`);
      new PagefindUI({
        element: '#pagefind-search',
        bundlePath,
        showSubResults: true,
        showImages: false,
      });
    } catch {
      if (container) {
        container.innerHTML =
          '<p class="text-sm text-stone-600">Search index is generated during production build (<code>npm run build</code>).</p>';
      }
    }
  }

  function focusSearchInput() {
    requestAnimationFrame(() => {
      const input = document.querySelector<HTMLInputElement>('#pagefind-search .pagefind-ui__search-input');
      input?.focus();
    });
  }

  async function openSearch() {
    searchDialog?.showModal();
    await initPagefind();
    focusSearchInput();
  }

  document.querySelectorAll('[data-open-search]').forEach((btn) => {
    btn.addEventListener('click', openSearch);
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (searchDialog?.open) {
        searchDialog.close();
      } else {
        openSearch();
      }
    }
  });

  closeBtn?.addEventListener('click', () => searchDialog?.close());
  searchDialog?.addEventListener('click', (e) => {
    if (e.target === searchDialog) searchDialog.close();
  });
</script>
