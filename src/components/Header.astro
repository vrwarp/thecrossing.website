---
import { NAV_ITEMS, SITE } from '../data/site';
import { url } from '../lib/url';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const target = url(href);
  return currentPath === target || (href !== '/' && currentPath.startsWith(target + '/'));
};
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-obsidian/95 text-white backdrop-blur-md">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href={url('/')} class="flex items-center gap-3 shrink-0" aria-label={SITE.name}>
      <img
        src={url('/images/site/logo.webp')}
        alt={SITE.name}
        class="h-7 w-auto sm:h-8"
        width="192"
        height="32"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {NAV_ITEMS.map((item) => (
        item.children ? (
          <div class="relative group">
            <a
              href={url(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'text-accent'
                  : 'text-stone-200 hover:bg-white/10 hover:text-white',
              ]}
            >
              <span>{item.label}</span>
              <svg class="h-3.5 w-3.5 opacity-60 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </a>
            <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute left-0 top-full pt-2 w-72 z-50">
              <ul class="rounded-xl border border-white/10 bg-charcoal p-2 shadow-2xl">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={url(child.href)}
                      class="block rounded-lg px-3 py-2.5 hover:bg-white/10 transition-colors"
                    >
                      <div class="text-sm font-semibold text-white">{child.label}</div>
                      {child.description && (
                        <div class="text-xs text-stone-400 mt-0.5">{child.description}</div>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-accent'
                : 'text-stone-200 hover:bg-white/10 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        data-open-search
        class="inline-flex items-center justify-center rounded-lg p-2 text-stone-300 hover:bg-white/10 hover:text-white transition-colors"
        aria-label="Search site"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </button>

      <a
        href={url('/give')}
        class="hidden sm:inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
      >
        Give
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        id="mobile-menu-open"
        class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-stone-200 hover:bg-white/10 hover:text-white"
        aria-label="Open navigation menu"
        aria-controls="mobile-nav-dialog"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Dialog -->
<dialog
  id="mobile-nav-dialog"
  class="m-0 ml-auto h-full max-h-full w-full max-w-sm bg-obsidian text-white p-0 backdrop:bg-black/70 backdrop:backdrop-blur-xs"
>
  <div class="flex h-full flex-col overflow-y-auto p-6">
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <span class="font-display text-lg font-bold tracking-tight">Menu</span>
      <button
        type="button"
        id="mobile-menu-close"
        class="rounded-lg p-2 text-stone-300 hover:bg-white/10 hover:text-white"
        aria-label="Close navigation menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mt-6 flex-1 space-y-2" aria-label="Mobile navigation">
      {NAV_ITEMS.map((item) => (
        item.children ? (
          <details class="group rounded-lg bg-white/5">
            <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-base font-semibold text-white list-none">
              <span>{item.label}</span>
              <svg class="h-4 w-4 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <ul class="space-y-1 px-3 pb-3">
              {item.children.map((child) => (
                <li>
                  <a
                    href={url(child.href)}
                    class="block rounded-md px-3 py-2 text-sm text-stone-300 hover:bg-white/10 hover:text-white"
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a
            href={url(item.href)}
            class="block rounded-lg bg-white/5 px-4 py-3 text-base font-semibold text-white hover:bg-white/10"
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="mt-6 border-t border-white/10 pt-6 space-y-3">
      <a
        href={url('/give')}
        class="block w-full rounded-lg bg-accent px-4 py-3 text-center text-sm font-bold text-obsidian hover:bg-accent-hover"
      >
        Give Online
      </a>
      <p class="text-center text-xs text-stone-400">
        {SITE.serviceTime} &bull; {SITE.address.full}
      </p>
    </div>
  </div>
</dialog>

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const dialog = document.getElementById('mobile-nav-dialog') as HTMLDialogElement | null;

  openBtn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
