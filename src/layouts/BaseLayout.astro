---
import '../styles/global.css';
import { SITE } from '../data/site';
import { absoluteUrl, url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

export interface Props {
  title: string;
  description?: string;
  indexable?: boolean;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  indexable = true,
  image = '/images/site/hero-sanctuary.webp',
  imageAlt = `${SITE.name} — ${SITE.tagline}`,
  ogType = 'website',
  structuredData,
} = Astro.props;

const pageTitle = title === SITE.name ? `${SITE.name} | Hayward, CA` : `${title} | ${SITE.name}`;
const siteOrigin = Astro.site ?? 'https://vrwarp.github.io';
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(normalizedPath, siteOrigin).toString();
const ogImageUrl = absoluteUrl(image, siteOrigin);
const homeUrl = absoluteUrl('/', siteOrigin);
const churchId = `${homeUrl}#church`;
const websiteId = `${homeUrl}#website`;

const isHome = normalizedPath === url('/');

const baseGraph: Record<string, unknown>[] = isHome
  ? [
      {
        '@type': 'Church',
        '@id': churchId,
        name: SITE.fullName,
        alternateName: SITE.name,
        url: homeUrl,
        logo: absoluteUrl('/images/site/logo.webp', siteOrigin),
        image: absoluteUrl('/images/site/hero-sanctuary.webp', siteOrigin),
        description: SITE.description,
        telephone: '+1-510-581-1630',
        email: SITE.email,
        address: {
          '@type': 'PostalAddress',
          streetAddress: SITE.address.street,
          addressLocality: 'Hayward',
          addressRegion: 'CA',
          postalCode: '94541',
          addressCountry: 'US',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 37.668326,
          longitude: -122.099152,
        },
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Sunday'],
            opens: '09:30',
            closes: '11:00',
          },
        ],
        areaServed: ['Hayward', 'Castro Valley', 'San Leandro', 'San Lorenzo', 'Union City', 'East Bay'],
        sameAs: [
          SITE.social.youtube,
          SITE.social.facebook,
          SITE.social.instagram,
          ...SITE.podcasts.filter((p) => p.primary).map((p) => p.href),
        ],
      },
      {
        '@type': 'WebSite',
        '@id': websiteId,
        url: homeUrl,
        name: SITE.name,
        description: SITE.description,
        publisher: { '@id': churchId },
      },
    ]
  : [
      {
        '@type': 'WebPage',
        '@id': `${canonicalUrl}#webpage`,
        url: canonicalUrl,
        name: pageTitle,
        description,
        isPartOf: { '@id': websiteId },
        about: { '@id': churchId },
      },
    ];

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...baseGraph, ...extraSchemas],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap-index.xml')} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#0B0D10" />
    <link rel="icon" type="image/x-icon" href={url('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-obsidian text-stone-900">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-obsidian"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-1 bg-stone-50" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
    </main>

    <Footer />
    <SearchModal />
  </body>
</html>
